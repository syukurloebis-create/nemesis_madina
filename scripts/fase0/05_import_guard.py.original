#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
NEMESIS FASE 0 - Import Guard
Mendeteksi duplicate modules dan circular imports
"""

import os
import sys
import ast
from pathlib import Path
from collections import defaultdict
from typing import Dict, List, Set, Tuple, Optional

SCRIPT_DIR = Path(__file__).parent.absolute()
PROJECT_ROOT = SCRIPT_DIR.parent.parent
sys.path.insert(0, str(PROJECT_ROOT))

class ImportGuard:
    def __init__(self, root_dir: Path):
        self.root_dir = root_dir
        self.imports: Dict[str, List[Path]] = defaultdict(list)
        self.duplicate_modules: List[Tuple[str, List[Path]]] = []
        self.circular_imports: List[Tuple[str, str]] = []
        self.module_graph: Dict[str, Set[str]] = defaultdict(set)
        self.all_modules: Set[str] = set()
        
    def should_scan(self, filepath: Path) -> bool:
        """Cek apakah file harus di-scan"""
        str_path = str(filepath)
        ignore = ['venv', 'node_modules', '__pycache__', '.pytest_cache', 'migrations']
        return not any(i in str_path for i in ignore)
    
    def get_module_name(self, filepath: Path) -> str:
        """Dapatkan nama module dari filepath"""
        rel_path = filepath.relative_to(self.root_dir)
        module_str = str(rel_path).replace('/', '.').replace('\\', '.')
        if module_str.endswith('.py'):
            module_str = module_str[:-3]
        if module_str.endswith('.__init__'):
            module_str = module_str[:-9]
        return module_str
    
    def scan_imports(self):
        """Scan semua import statements"""
        print("🔍 Scanning imports...")
        
        for py_file in self.root_dir.rglob("*.py"):
            if not self.should_scan(py_file):
                continue
            
            module_name = self.get_module_name(py_file)
            self.all_modules.add(module_name)
            
            try:
                with open(py_file, 'r', encoding='utf-8', errors='ignore') as f:
                    content = f.read()
                
                tree = ast.parse(content)
                
                for node in ast.walk(tree):
                    # Import: import x, y
                    if isinstance(node, ast.Import):
                        for alias in node.names:
                            imported = alias.name.split('.')[0]
                            self.imports[imported].append(py_file)
                            self.module_graph[module_name].add(imported)
                    
                    # Import from: from x import y
                    elif isinstance(node, ast.ImportFrom):
                        if node.module:
                            imported = node.module.split('.')[0]
                            self.imports[imported].append(py_file)
                            self.module_graph[module_name].add(imported)
                            
            except SyntaxError as e:
                print(f"   ⚠️ Syntax error in {py_file}: {e}")
            except Exception as e:
                print(f"   ⚠️ Error scanning {py_file}: {e}")
        
        print(f"   Scanned {len(self.all_modules)} modules")
    
    def detect_duplicate_modules(self):
        """Deteksi modul dengan nama yang sama"""
        print("🔍 Detecting duplicate modules...")
        
        # Group by module name (last part)
        module_name_map: Dict[str, List[Path]] = defaultdict(list)
        
        for module in self.all_modules:
            last_part = module.split('.')[-1]
            if last_part and last_part != '__init__':
                module_name_map[last_part].append(module)
        
        # Find duplicates (exclude common names)
        common_names = {'__init__', '__main__', 'conftest', 'setup', 'models', 'utils'}
        
        for module_name, modules in module_name_map.items():
            if module_name in common_names:
                continue
            if len(modules) > 1:
                # Get file paths
                file_paths = []
                for mod in modules:
                    mod_path = mod.replace('.', '/')
                    for ext in ['', '.py', '/__init__.py']:
                        p = self.root_dir / f"{mod_path}{ext}"
                        if p.exists():
                            file_paths.append(p)
                            break
                
                if len(file_paths) > 1:
                    self.duplicate_modules.append((module_name, file_paths))
        
        print(f"   Found {len(self.duplicate_modules)} duplicate module names")
    
    def detect_circular_imports(self):
        """Deteksi circular imports menggunakan DFS"""
        print("🔍 Detecting circular imports...")
        
        VISITED = 1
        RECURSION_STACK = 2
        
        state: Dict[str, int] = {}
        
        def dfs(node: str, path: List[str]) -> Optional[List[str]]:
            if node not in state:
                state[node] = VISITED
                path.append(node)
                
                for neighbor in self.module_graph.get(node, set()):
                    if neighbor not in self.all_modules:
                        continue
                    
                    result = dfs(neighbor, path)
                    if result:
                        return result
                
                path.pop()
                state[node] = RECURSION_STACK
            
            elif state[node] == VISITED:
                # Found cycle
                cycle_start = path.index(node) if node in path else -1
                if cycle_start >= 0:
                    return path[cycle_start:] + [node]
            
            return None
        
        for module in self.all_modules:
            cycle = dfs(module, [])
            if cycle:
                for i in range(len(cycle)-1):
                    self.circular_imports.append((cycle[i], cycle[i+1]))
                break  # Stop at first cycle
        
        print(f"   Found {len(self.circular_imports)} circular import edges")
    
    def generate_report(self) -> str:
        """Generate laporan"""
        report = []
        report.append("# NEMESIS IMPORT GUARD REPORT\n")
        report.append(f"Generated: {datetime.now().isoformat()}\n")
        report.append("=" * 60 + "\n")
        
        # Summary
        report.append("\n## SUMMARY\n")
        report.append(f"- Total modules: {len(self.all_modules)}")
        report.append(f"- Duplicate modules: {len(self.duplicate_modules)}")
        report.append(f"- Circular imports: {len(self.circular_imports)}")
        
        # Duplicate modules
        if self.duplicate_modules:
            report.append("\n## DUPLICATE MODULES\n")
            for module_name, files in self.duplicate_modules[:10]:
                report.append(f"\n### {module_name}\n")
                for f in files:
                    report.append(f"  - `{f}`")
        
        # Circular imports
        if self.circular_imports:
            report.append("\n## CIRCULAR IMPORTS\n")
            for from_mod, to_mod in self.circular_imports[:20]:
                report.append(f"- `{from_mod}` → `{to_mod}`")
        
        # Recommendation
        if self.duplicate_modules or self.circular_imports:
            report.append("\n## RECOMMENDATIONS\n")
            if self.duplicate_modules:
                report.append("1. **Fix duplicate modules**: Rename or consolidate duplicate modules")
            if self.circular_imports:
                report.append("2. **Break circular imports**: Use dependency injection or restructure")
        
        return "\n".join(report)
    
    def run(self) -> bool:
        """Jalankan semua pemeriksaan"""
        print("\n" + "="*60)
        print("NEMESIS IMPORT GUARD")
        print("="*60 + "\n")
        
        self.scan_imports()
        self.detect_duplicate_modules()
        self.detect_circular_imports()
        
        # Save report
        report_dir = PROJECT_ROOT / "reports" / "fase0"
        report_dir.mkdir(parents=True, exist_ok=True)
        
        report_path = report_dir / "import_guard_report.md"
        with open(report_path, 'w') as f:
            f.write(self.generate_report())
        
        print(f"\n📄 Report saved: {report_path}")
        
        # Return True if no critical issues
        has_critical = len(self.duplicate_modules) > 5 or len(self.circular_imports) > 0
        
        if has_critical:
            print("\n❌ IMPORT GUARD FAILED")
            print(f"   Critical issues found: {len(self.duplicate_modules)} duplicates, {len(self.circular_imports)} circular")
            return False
        
        print("\n✅ IMPORT GUARD PASSED")
        return True


if __name__ == "__main__":
    from datetime import datetime
    guard = ImportGuard(PROJECT_ROOT)
    success = guard.run()
    sys.exit(0 if success else 1)