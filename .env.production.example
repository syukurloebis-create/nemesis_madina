# Production Environment Template
# Copy to .env.production and fill in actual production values
# NEVER commit actual .env.production to git

ENVIRONMENT=production
DEBUG=false

# Database (REQUIRED)
DATABASE_URL=postgresql+asyncpg://nemesis:<DB_PASSWORD>@localhost:5432/nemesis_db

# JWT
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# Redis (REQUIRED)
REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6379/0
REDIS_CACHE_TTL=300

# CORS Production
CORS_ORIGINS=https://your-domain.com

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# Logging
LOG_LEVEL=ERROR
LOG_FILE=/var/log/nemesis/app.log
