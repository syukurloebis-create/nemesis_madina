import React, { useEffect, useState } from 'react'
import axios from 'axios'
import {
  LineChart, Line, XAxis, YAxis, CartesianGrid, Tooltip, Legend, ResponsiveContainer,
  PieChart, Pie, Cell
} from 'recharts'

const API_BASE = 'http://localhost:8000'

// ============================================================
// INTERFACES
// ============================================================

interface StrategicDashboard {
  summary: {
    total_cases: number;
    high_risk_cases: number;
    closure_rate: number;
    total_loss: number;
    total_recovered: number;
    recovery_rate: number;
  };
  risk_distribution: Array<{ level: string; count: number }>;
  trend: Array<{ month: string; cases: number }>;
  graph_intelligence: {
    total_entities: number;
    total_vendors: number;
    total_relationships: number;
    collusion_edges: number;
  };
  alerts: { active: number; pending: number };
  timestamp: string;
}

// ============================================================
// COLOR PALETTE
// ============================================================

const COLORS = {
  critical: '#b71c1c',
  high: '#d32f2f',
  medium: '#ff9800',
  low: '#4caf50',
  primary: '#1976d2',
  background: '#0a0e1a',
  card: '#151929',
  border: '#2a2a4a',
  text: '#ffffff',
  textSecondary: '#666666'
}

const CHART_COLORS = ['#d32f2f', '#ff9800', '#4caf50', '#1976d2']

// ============================================================
// MAIN COMPONENT
// ============================================================

function App() {
  const [loading, setLoading] = useState(true)
  const [data, setData] = useState<StrategicDashboard | null>(null)
  const [error, setError] = useState<string | null>(null)

  useEffect(() => {
    fetchDashboardData()
  }, [])

  const fetchDashboardData = async () => {
    try {
      setError(null)
      const response = await axios.get(`${API_BASE}/strategic/dashboard`)
      setData(response.data)
    } catch (err) {
      console.error('Error fetching dashboard:', err)
      setError('Gagal memuat data dashboard')
    } finally {
      setLoading(false)
    }
  }

  const formatCurrency = (value: number) => {
    if (!value) return 'Rp0'
    return new Intl.NumberFormat('id-ID', {
      style: 'currency',
      currency: 'IDR',
      minimumFractionDigits: 0,
      maximumFractionDigits: 0
    }).format(value)
  }

  if (loading) {
    return (
      <div style={{ display: 'flex', justifyContent: 'center', alignItems: 'center', height: '100vh', background: COLORS.background }}>
        <div style={{ textAlign: 'center', color: COLORS.text }}>
          <h1 style={{ color: COLORS.primary }}>NEMESIS V8+</h1>
          <p style={{ color: COLORS.textSecondary }}>Loading Strategic Intelligence...</p>
        </div>
      </div>
    )
  }

  if (error) {
    return (
      <div style={{ display: 'flex', justifyContent: 'center', alignItems: 'center', height: '100vh', background: COLORS.background }}>
        <div style={{ textAlign: 'center', color: COLORS.text, padding: '40px', background: COLORS.card, borderRadius: '12px' }}>
          <h2 style={{ color: COLORS.high }}>⚠️ Error</h2>
          <p>{error}</p>
          <button onClick={fetchDashboardData} style={{ padding: '10px 24px', background: COLORS.primary, color: '#fff', border: 'none', borderRadius: '8px', cursor: 'pointer', marginTop: '16px' }}>
            Coba Lagi
          </button>
        </div>
      </div>
    )
  }

  if (!data) return null

  const s = data.summary
  const riskData = data.risk_distribution || []
  const trendData = data.trend || []
  const graph = data.graph_intelligence || { total_entities: 0, total_vendors: 0, total_relationships: 0, collusion_edges: 0 }

  return (
    <div style={{
      minHeight: '100vh',
      background: COLORS.background,
      color: COLORS.text,
      padding: '24px',
      fontFamily: 'Arial, sans-serif'
    }}>

      {/* Header */}
      <div style={{
        display: 'flex',
        justifyContent: 'space-between',
        alignItems: 'center',
        marginBottom: '32px',
        borderBottom: `1px solid ${COLORS.border}`,
        paddingBottom: '16px'
      }}>
        <div>
          <h1 style={{ margin: 0, color: COLORS.primary, fontSize: '24px' }}>
            ⚡ NEMESIS V8+
          </h1>
          <p style={{ margin: '4px 0 0', color: COLORS.textSecondary, fontSize: '14px' }}>
            STRATEGIC INTELLIGENCE CENTER
          </p>
        </div>
        <div style={{ display: 'flex', gap: '12px' }}>
          <span style={{ padding: '6px 16px', background: COLORS.card, borderRadius: '20px', fontSize: '12px', border: `1px solid ${COLORS.border}` }}>
            🟢 Online
          </span>
          <span style={{ padding: '6px 16px', background: COLORS.card, borderRadius: '20px', fontSize: '12px', border: `1px solid ${COLORS.border}` }}>
            {new Date().toLocaleString('id-ID')}
          </span>
        </div>
      </div>

      {/* ROW 1: Executive Summary - 5 Cards */}
      <div style={{ display: 'grid', gridTemplateColumns: 'repeat(5, 1fr)', gap: '16px', marginBottom: '24px' }}>
        <div style={{ padding: '20px', background: COLORS.card, borderRadius: '12px', border: `1px solid ${COLORS.border}`, textAlign: 'center' }}>
          <div style={{ fontSize: '12px', color: COLORS.textSecondary, textTransform: 'uppercase' }}>Total Kasus</div>
          <div style={{ fontSize: '32px', fontWeight: 'bold' }}>{s.total_cases}</div>
        </div>

        <div style={{ padding: '20px', background: COLORS.card, borderRadius: '12px', border: `1px solid ${COLORS.border}`, textAlign: 'center' }}>
          <div style={{ fontSize: '12px', color: COLORS.textSecondary, textTransform: 'uppercase' }}>Risiko Tinggi</div>
          <div style={{ fontSize: '32px', fontWeight: 'bold', color: COLORS.high }}>{s.high_risk_cases}</div>
        </div>

        <div style={{ padding: '20px', background: COLORS.card, borderRadius: '12px', border: `1px solid ${COLORS.border}`, textAlign: 'center' }}>
          <div style={{ fontSize: '12px', color: COLORS.textSecondary, textTransform: 'uppercase' }}>Potensi Kerugian</div>
          <div style={{ fontSize: '18px', fontWeight: 'bold', color: '#ff9800' }}>{formatCurrency(s.total_loss)}</div>
        </div>

        <div style={{ padding: '20px', background: COLORS.card, borderRadius: '12px', border: `1px solid ${COLORS.border}`, textAlign: 'center' }}>
          <div style={{ fontSize: '12px', color: COLORS.textSecondary, textTransform: 'uppercase' }}>Tingkat Pemulihan</div>
          <div style={{ fontSize: '32px', fontWeight: 'bold', color: COLORS.low }}>{s.recovery_rate}%</div>
        </div>

        <div style={{ padding: '20px', background: COLORS.card, borderRadius: '12px', border: `1px solid ${COLORS.border}`, textAlign: 'center' }}>
          <div style={{ fontSize: '12px', color: COLORS.textSecondary, textTransform: 'uppercase' }}>Integrity</div>
          <div style={{ fontSize: '32px', fontWeight: 'bold', color: COLORS.low }}>100%</div>
        </div>
      </div>

      {/* ROW 2: Charts & Intelligence */}
      <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '16px', marginBottom: '24px' }}>
        {/* Risk Distribution Pie Chart */}
        <div style={{ padding: '20px', background: COLORS.card, borderRadius: '12px', border: `1px solid ${COLORS.border}` }}>
          <h3 style={{ margin: '0 0 16px', fontSize: '16px' }}>📊 Risk Distribution</h3>
          {riskData.length > 0 ? (
            <ResponsiveContainer width="100%" height={250}>
              <PieChart>
                <Pie
                  data={riskData}
                  dataKey="count"
                  nameKey="level"
                  cx="50%"
                  cy="50%"
                  outerRadius={80}
                  label
                >
                  {riskData.map((entry, index) => (
                    <Cell key={`cell-${index}`} fill={CHART_COLORS[index % CHART_COLORS.length]} />
                  ))}
                </Pie>
                <Tooltip
                  contentStyle={{ background: COLORS.card, border: `1px solid ${COLORS.border}`, borderRadius: '8px' }}
                  labelStyle={{ color: COLORS.text }}
                />
                <Legend />
              </PieChart>
            </ResponsiveContainer>
          ) : (
            <div style={{ textAlign: 'center', color: COLORS.textSecondary, padding: '40px' }}>
              No risk distribution data available
            </div>
          )}
        </div>

        {/* Trend Chart */}
        <div style={{ padding: '20px', background: COLORS.card, borderRadius: '12px', border: `1px solid ${COLORS.border}` }}>
          <h3 style={{ margin: '0 0 16px', fontSize: '16px' }}>📈 Case Trend</h3>
          {trendData.length > 0 ? (
            <ResponsiveContainer width="100%" height={250}>
              <LineChart data={trendData}>
                <CartesianGrid strokeDasharray="3 3" stroke={COLORS.border} />
                <XAxis dataKey="month" stroke={COLORS.textSecondary} />
                <YAxis stroke={COLORS.textSecondary} />
                <Tooltip
                  contentStyle={{ background: COLORS.card, border: `1px solid ${COLORS.border}`, borderRadius: '8px' }}
                  labelStyle={{ color: COLORS.text }}
                />
                <Line type="monotone" dataKey="cases" stroke={COLORS.primary} strokeWidth={3} />
              </LineChart>
            </ResponsiveContainer>
          ) : (
            <div style={{ textAlign: 'center', color: COLORS.textSecondary, padding: '40px' }}>
              No trend data available
            </div>
          )}
        </div>
      </div>

      {/* ROW 3: Graph Intelligence */}
      <div style={{ display: 'grid', gridTemplateColumns: 'repeat(4, 1fr)', gap: '16px', marginBottom: '24px' }}>
        <div style={{ padding: '20px', background: COLORS.card, borderRadius: '12px', border: `1px solid ${COLORS.border}`, textAlign: 'center' }}>
          <div style={{ fontSize: '12px', color: COLORS.textSecondary }}>Entities</div>
          <div style={{ fontSize: '28px', fontWeight: 'bold', color: COLORS.primary }}>{graph.total_entities}</div>
        </div>
        <div style={{ padding: '20px', background: COLORS.card, borderRadius: '12px', border: `1px solid ${COLORS.border}`, textAlign: 'center' }}>
          <div style={{ fontSize: '12px', color: COLORS.textSecondary }}>Vendors</div>
          <div style={{ fontSize: '28px', fontWeight: 'bold', color: COLORS.primary }}>{graph.total_vendors}</div>
        </div>
        <div style={{ padding: '20px', background: COLORS.card, borderRadius: '12px', border: `1px solid ${COLORS.border}`, textAlign: 'center' }}>
          <div style={{ fontSize: '12px', color: COLORS.textSecondary }}>Relationships</div>
          <div style={{ fontSize: '28px', fontWeight: 'bold', color: '#ff9800' }}>{graph.total_relationships}</div>
        </div>
        <div style={{ padding: '20px', background: COLORS.card, borderRadius: '12px', border: `1px solid ${COLORS.border}`, textAlign: 'center' }}>
          <div style={{ fontSize: '12px', color: COLORS.textSecondary }}>Collusion Edges</div>
          <div style={{ fontSize: '28px', fontWeight: 'bold', color: COLORS.high }}>{graph.collusion_edges}</div>
        </div>
      </div>

      {/* Footer */}
      <div style={{
        marginTop: '32px',
        padding: '16px',
        textAlign: 'center',
        borderTop: `1px solid ${COLORS.border}`,
        color: COLORS.textSecondary,
        fontSize: '12px'
      }}>
        NEMESIS V8+ Strategic Intelligence Center | Integrity: 100% | {new Date().toLocaleString('id-ID')}
      </div>
    </div>
  )
}

export default App
