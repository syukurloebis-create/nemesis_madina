const API_BASE_URL = import.meta.env.VITE_API_URL || 'http://localhost';

class APIClient {
  private token: string | null = null;

  constructor() {
    this.token = localStorage.getItem('auth_token');
  }

  setToken(token: string) {
    this.token = token;
    localStorage.setItem('auth_token', token);
  }

  getToken(): string | null {
    return this.token || localStorage.getItem('auth_token');
  }

  async request(endpoint: string, options: RequestInit = {}): Promise<any> {
    const url = `${API_BASE_URL}${endpoint}`;
    const headers: HeadersInit = {};

    const token = this.getToken();
    if (token) {
      headers['Authorization'] = `Bearer ${token}`;
    }

    if (options.method && options.method !== 'GET' && options.body) {
      headers['Content-Type'] = 'application/json';
    }

    const response = await fetch(url, { ...options, headers });
    
    if (response.status === 401) {
      localStorage.removeItem('auth_token');
      window.location.href = '/login';
      throw new Error('Session expired');
    }
    
    if (!response.ok) {
      throw new Error(`HTTP ${response.status}`);
    }
    
    return response.json();
  }

  async get(endpoint: string): Promise<any> {
    return this.request(endpoint);
  }

  async post(endpoint: string, data?: any): Promise<any> {
    return this.request(endpoint, {
      method: 'POST',
      body: data ? JSON.stringify(data) : undefined,
    });
  }

  async put(endpoint: string, data?: any): Promise<any> {
    return this.request(endpoint, {
      method: 'PUT',
      body: data ? JSON.stringify(data) : undefined,
    });
  }

  // Auth
  async login(username: string, password: string) {
    const result = await this.post('/auth/login', { username, password });
    if (result.access_token) {
      this.setToken(result.access_token);
    }
    return result;
  }

  async logout() {
    this.token = null;
    localStorage.removeItem('auth_token');
    window.location.href = '/login';
  }

  // Cases
  async getCases(): Promise<any[]> {
    const result = await this.get('/cases/');
    return result.data || result || [];
  }

  async getCase(id: string): Promise<any> {
    const result = await this.get(`/cases/${id}`);
    return result.data || result;
  }

  async createCase(data: any): Promise<any> {
    const result = await this.post('/cases/', data);
    return result.data || result;
  }

  // Forensic & Integrity
  async getIntegritySummary(): Promise<any> {
    return this.get('/integrity/summary/overview');
  }

  async verifyHashChain(caseId: string): Promise<any> {
    return this.get(`/rebuild/case/${caseId}/verify-chain`);
  }

  async getCaseTimeline(caseId: string): Promise<any> {
    return this.get(`/historical/case/${caseId}/timeline`);
  }

  async getDomainState(caseId: string): Promise<any> {
    return this.get(`/rebuild/case/${caseId}/domain-state`);
  }

  async getEvents(caseId: string): Promise<any> {
    return this.get(`/historical/case/${caseId}/timeline`);
  }

  // Alerts
  async getAlerts(limit: number = 50): Promise<any[]> {
    const result = await this.get(`/alerts/?limit=${limit}`);
    return result.data || result || [];
  }

  async getAlertStats(): Promise<any> {
    return this.get('/alerts/summary/stats');
  }

  // Metrics
  async getTrustMetrics(): Promise<any> {
    return this.get('/trust-metrics/summary');
  }

  async getRiskMetrics(): Promise<any> {
    return this.get('/risk-metrics/summary');
  }

  async getReplayMetrics(): Promise<any> {
    return this.get('/replay-metrics/summary');
  }

  // Graph
  async getGraphNodes(): Promise<any> {
    return this.get('/lineage/nodes');
  }

  async getNodeLineage(nodeId: string): Promise<any> {
    return this.get(`/lineage/node/${nodeId}/lineage`);
  }

  // Dashboard
  async getDashboardSummary(): Promise<any> {
    return this.get('/api/dashboard/summary');
  }

  // Health
  async getHealth(): Promise<any> {
    return this.get('/health');
  }
}

export const api = new APIClient();

export const API_ENDPOINTS = {
  DASHBOARD_SUMMARY: '/api/dashboard/summary',
  TRUST_METRICS: '/trust-metrics/summary',
  RISK_METRICS: '/risk-metrics/summary',
  REPLAY_METRICS: '/replay-metrics/summary',
  ALERTS: '/alerts/',
  ALERT_STATS: '/alerts/summary/stats',
  CASES: '/cases/',
  HEALTH: '/health',
  LOGIN: '/auth/login',
  REGISTER: '/auth/register',
  LINEAGE_NODES: '/lineage/nodes',
  SNAPSHOTS: '/snapshots/case',
  REPLAY: '/replay/case',
  HISTORICAL: '/historical/case',
  INTEGRITY_SUMMARY: '/integrity/summary/overview',
};

export const checkAuthStatus = () => {
  const token = localStorage.getItem('auth_token');
  console.log('Auth status - Token exists:', !!token);
  return !!token;
};

