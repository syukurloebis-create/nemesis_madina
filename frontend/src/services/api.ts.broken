export const API_ENDPOINTS = {
  DASHBOARD_SUMMARY: "/api/dashboard/summary",
  TRUST_METRICS: "/trust-metrics/summary",
  RISK_METRICS: "/risk-metrics/summary",
  REPLAY_METRICS: "/replay-metrics/summary",
  ALERTS: "/alerts/",
  ALERT_STATS: "/alerts/summary/stats",
  CASES: "/cases/",
  HEALTH: "/health",
  LOGIN: "/auth/login",
  REGISTER: "/auth/register",
  LINEAGE_NODES: "/lineage/nodes",
  SNAPSHOTS: "/snapshots/case",
  REPLAY: "/replay/case",
  HISTORICAL: "/historical/case",
};

const API_BASE_URL = import.meta.env.VITE_API_URL || 'http://localhost';

export interface Case {
  id: string;
  title: string;
  description: string;
  status: string;
  priority: string;
  created_at: string;
  updated_at: string;
}

export interface TimelineEvent {
  version: number;
  event_type: string;
  timestamp: string;
  user_id: string;
  data: Record<string, any>;
}

export interface Alert {
  id: string;
  title: string;
  description: string;
  severity: 'critical' | 'high' | 'medium' | 'low';
  status: 'new' | 'acknowledged' | 'resolved';
  timestamp: string;
}

class APIClient {
  private token: string | null = null;

  constructor() {
    this.token = localStorage.getItem('auth_token');
  }

  setToken(token: string) {
    this.token = token;
    localStorage.setItem('auth_token', token);
  }

  getToken(): string | null {
    return this.token || localStorage.getItem('auth_token');
  }

  async request<T>(endpoint: string, options: RequestInit = {}): Promise<T> {
    const url = `${API_BASE_URL}${endpoint}`;
    const headers: HeadersInit = {
      'Content-Type': 'application/json',
      ...options.headers,
    };

    const token = this.getToken();
    if (token) {
      headers['Authorization'] = `Bearer ${token}`;
    }

    const response = await fetch(url, { ...options, headers });
    
    if (response.status === 401) {
      localStorage.removeItem('auth_token');
      window.location.href = '/login';
      throw new Error('Session expired');
    }
    
    if (!response.ok) {
      throw new Error(`HTTP ${response.status}`);
    }
    
    return response.json();
  }

  // Auth
  async login(username: string, password: string) {
    const result = await this.request<{ access_token: string; user?: any }>('/auth/login', {
      method: 'POST',
      body: JSON.stringify({ username, password }),
    });
    if (result.access_token) {
      this.setToken(result.access_token);
    }
    return result;
  }

  async logout() {
    this.token = null;
    localStorage.removeItem('auth_token');
    window.location.href = '/login';
  }

  // Cases
  async getCases(): Promise<Case[]> {
    const result = await this.request<{ data: Case[] }>('/cases/');
    return result.data || [];
  }

  async getCase(id: string): Promise<Case> {
    const result = await this.request<{ data: Case }>(`/cases/${id}`);
    return result.data;
  }

  async createCase(data: Partial<Case>): Promise<Case> {
    const result = await this.request<{ data: Case }>('/cases/', {
      method: 'POST',
      body: JSON.stringify(data),
    });
    return result.data;
  }

  // Historical / Forensic
  async getTimeline(caseId: string): Promise<{ timeline: TimelineEvent[]; total_events: number }> {
    return this.request(`/historical/case/${caseId}/timeline`);
  }

  async getAuditTrail(caseId: string): Promise<any> {
    return this.request(`/historical/case/${caseId}/audit-trail`);
  }

  async getForensicReport(caseId: string): Promise<any> {
    return this.request(`/historical/case/${caseId}/forensic-report`);
  }

  // Replay
  async replayCase(caseId: string): Promise<any> {
    return this.request(`/replay/case/${caseId}/replay`, { method: 'POST' });
  }

  async getReplayTimeline(caseId: string): Promise<any> {
    return this.request(`/replay/case/${caseId}/timeline`);
  }

  // Snapshots
  async getSnapshots(caseId: string): Promise<any> {
    return this.request(`/snapshots/case/${caseId}`);
  }

  async getLatestSnapshot(caseId: string): Promise<any> {
    return this.request(`/snapshots/case/${caseId}/latest`);
  }

  async createSnapshot(caseId: string, version?: number): Promise<any> {
    return this.request(`/snapshots/case/${caseId}`, {
      method: 'POST',
      body: JSON.stringify({ version: version || 1 }),
    });
  }

  // Alerts
  async getAlerts(limit = 50): Promise<Alert[]> {
    return this.request(`/alerts/?limit=${limit}`);
  }

  async getAlertStats(): Promise<any> {
    return this.request('/alerts/summary/stats');
  }

  async acknowledgeAlert(alertId: string): Promise<void> {
    await this.request(`/alerts/${alertId}/acknowledge`, {
      method: 'POST',
      body: JSON.stringify({ alert_id: alertId, user: 'admin' }),
    });
  }

  async resolveAlert(alertId: string, note: string): Promise<void> {
    await this.request(`/alerts/${alertId}/resolve`, {
      method: 'POST',
      body: JSON.stringify({ alert_id: alertId, user: 'admin', note }),
    });
  }

  // Metrics
  async getTrustMetrics(): Promise<any> {
    return this.request('/trust-metrics/summary');
  }

  async getRiskMetrics(): Promise<any> {
    return this.request('/risk-metrics/summary');
  }

  async getReplayMetrics(): Promise<any> {
    return this.request('/replay-metrics/summary');
  }

  // Graph Intelligence
  async getGraphNodes(): Promise<any> {
    return this.request('/lineage/nodes');
  }

  async getNodeLineage(nodeId: string): Promise<any> {
    return this.request(`/lineage/node/${nodeId}/lineage`);
  }

  // Dashboard Summary
  async getDashboardSummary(): Promise<any> {
    return this.request('/api/dashboard/summary');
  }

  // Health
  async getHealth(): Promise<any> {
    return this.request('/health');
  }
}

export const api = new APIClient();

  // Generic GET method
  async get<T>(endpoint: string): Promise<T> {
    return this.request<T>(endpoint);
  }

  // Generic POST method
  async post<T>(endpoint: string, data?: any): Promise<T> {
    return this.request<T>(endpoint, {
      method: 'POST',
      body: data ? JSON.stringify(data) : undefined,
    });
  }

  // Generic PUT method
  async put<T>(endpoint: string, data?: any): Promise<T> {
    return this.request<T>(endpoint, {
      method: 'PUT',
      body: data ? JSON.stringify(data) : undefined,
    });
  }

  // Generic DELETE method
  async delete<T>(endpoint: string): Promise<T> {
    return this.request<T>(endpoint, {
      method: 'DELETE',
    });
  }
