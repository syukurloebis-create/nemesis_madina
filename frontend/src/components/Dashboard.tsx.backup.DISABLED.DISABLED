import React, { useEffect, useState } from 'react';
import { getDashboardMetrics, getGraphStats } from '../services/api';
import {
  Chart as ChartJS,
  CategoryScale,
  LinearScale,
  BarElement,
  Title,
  Tooltip,
  Legend,
  ArcElement,
  PointElement,
  LineElement,
  Filler,
} from 'chart.js';
import { Bar, Pie, Line } from 'react-chartjs-2';

ChartJS.register(
  CategoryScale,
  LinearScale,
  BarElement,
  Title,
  Tooltip,
  Legend,
  ArcElement,
  PointElement,
  LineElement,
  Filler
);

interface DashboardMetrics {
  procurement: {
    total_vendor: number;
    total_paket: number;
    total_nilai: number;
    total_nilai_formatted: string;
  };
  cases: {
    total_kasus: number;
    kasus_aktif: number;
    risiko_tinggi: number;
  };
  integrity: {
    total_agregat: number;
    total_event: number;
    status: string;
  };
  evidence: {
    total_dokumen: number;
  };
  collusion: {
    total_pola: number;
  };
  alerts: {
    aktif: number;
  };
}

export default function Dashboard() {
  const [metrics, setMetrics] = useState<DashboardMetrics | null>(null);
  const [graphStats, setGraphStats] = useState<any>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    const loadData = async () => {
      try {
        const [metricsRes, graphRes] = await Promise.all([
          getDashboardMetrics(),
          getGraphStats().catch(() => ({ data: null }))
        ]);
        setMetrics(metricsRes.data);
        setGraphStats(graphRes.data);
        setError(null);
      } catch (err: any) {
        console.error('Failed to load dashboard:', err);
        setError(err.message);
      } finally {
        setLoading(false);
      }
    };
    loadData();
  }, []);

  if (loading) {
    return (
      <div className="flex items-center justify-center h-96">
        <div className="text-gray-500 text-lg">Loading dashboard data...</div>
      </div>
    );
  }

  if (error) {
    return (
      <div className="bg-red-900/20 border border-red-500 rounded-lg p-6 m-6">
        <p className="text-red-400 text-lg">⚠️ Connection Error</p>
        <p className="text-gray-400 mt-2">{error}</p>
        <p className="text-gray-500 text-sm mt-4">Make sure backend is running at http://localhost:8000</p>
      </div>
    );
  }

  const kpiCards = [
    { title: 'Total Vendors', value: metrics?.procurement.total_vendor || 0, color: '#00d4ff', icon: '🏢' },
    { title: 'Total Packages', value: metrics?.procurement.total_paket || 0, color: '#4d9de0', icon: '📦' },
    { title: 'Total Value', value: metrics?.procurement.total_nilai_formatted || 'Rp0', color: '#6bcb77', icon: '💰' },
    { title: 'Collusion Edges', value: graphStats?.collusion_edges || metrics?.collusion.total_pola || 0, color: '#ff6b6b', icon: '🚨' },
    { title: 'Active Cases', value: metrics?.cases.kasus_aktif || 0, color: '#ffd93d', icon: '⚖️' },
    { title: 'Evidence Items', value: metrics?.evidence.total_dokumen || 0, color: '#e0aaff', icon: '🔍' },
  ];

  const yearChartData = {
    labels: ['2022', '2023', '2024', '2025', '2026'],
    datasets: [{ label: 'Packages', data: [1120, 1275, 1155, 0, 80], backgroundColor: '#00d4ff', borderRadius: 8 }]
  };

  const caseStatusData = {
    labels: ['Open', 'In Progress', 'Closed'],
    datasets: [{ data: [metrics?.cases.kasus_aktif || 6, 0, 0], backgroundColor: ['#00d4ff', '#ffd93d', '#6bcb77'] }]
  };

  const fraudTrendData = {
    labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
    datasets: [{ label: 'Fraud Alerts', data: [0, 0, 0, 0, 0, 0], borderColor: '#ff6b6b', backgroundColor: 'rgba(255, 107, 107, 0.1)', fill: true, tension: 0.4 }]
  };

  return (
    <div className="p-6">
      <h1 className="text-2xl font-bold text-cyan-400 mb-6">Executive Dashboard</h1>
      <p className="text-gray-400 mb-6">Real-time procurement intelligence & fraud detection</p>

      {/* KPI Cards */}
      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-4 mb-6">
        {kpiCards.map((card, idx) => (
          <div key={idx} className="bg-gray-800 rounded-lg p-4 text-center">
            <div className="text-3xl mb-2">{card.icon}</div>
            <div className="text-2xl font-bold" style={{ color: card.color }}>{card.value.toLocaleString()}</div>
            <div className="text-gray-400 text-sm">{card.title}</div>
          </div>
        ))}
      </div>

      {/* Charts */}
      <div className="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
        <div className="bg-gray-800 rounded-lg p-4">
          <h2 className="text-lg font-semibold text-cyan-400 mb-3">Packages by Year</h2>
          <Bar data={yearChartData} options={{ responsive: true, plugins: { legend: { position: 'top' } } }} />
        </div>
        <div className="bg-gray-800 rounded-lg p-4">
          <h2 className="text-lg font-semibold text-cyan-400 mb-3">Case Status Distribution</h2>
          <Pie data={caseStatusData} options={{ responsive: true }} />
        </div>
      </div>

      <div className="grid grid-cols-1 gap-6">
        <div className="bg-gray-800 rounded-lg p-4">
          <h2 className="text-lg font-semibold text-cyan-400 mb-3">Fraud Detection Trend</h2>
          <Line data={fraudTrendData} options={{ responsive: true, plugins: { legend: { position: 'top' } } }} />
        </div>
      </div>

      {/* Footer */}
      <div className="mt-6 text-center text-gray-500 text-sm">
        API Endpoint: http://localhost:8000 | Last Updated: {new Date().toLocaleString()}
      </div>
    </div>
  );
}
