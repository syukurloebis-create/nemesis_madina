// IntelligenceKPICards.tsx - KPI Cards for AI Command Center
import React from 'react';
import { Briefcase, AlertTriangle, Shield, DollarSign } from 'lucide-react';

interface IntelligenceKPICardsProps {
  data: {
    executive?: any;
    cases?: any;
    evidence?: any;
    keyActors?: any[];
  };
}

export const IntelligenceKPICards: React.FC<IntelligenceKPICardsProps> = ({ data }) => {
  const { executive, cases, evidence, keyActors } = data;
  
  const riskLevel = executive?.risk_level || { critical: 0, high: 0, medium: 0, low: 0 };
  const totalCases = riskLevel.critical + riskLevel.high + riskLevel.medium + riskLevel.low;

  const cards = [
    {
      label: 'ACTIVE CASES',
      value: totalCases,
      subValue: `${riskLevel.high} high risk`,
      icon: Briefcase,
      color: 'text-blue-400',
      bg: 'bg-blue-500/10',
      border: 'border-blue-500/20',
    },
    {
      label: 'FRAUD DETECTED',
      value: executive?.fraud_detected || 2,
      subValue: 'AI flagged',
      icon: AlertTriangle,
      color: 'text-red-400',
      bg: 'bg-red-500/10',
      border: 'border-red-500/20',
    },
    {
      label: 'LOSS PREVENTED',
      value: `Rp${(executive?.loss_prevented || 2.5).toFixed(1)}M`,
      subValue: 'Estimated recovery',
      icon: DollarSign,
      color: 'text-green-400',
      bg: 'bg-green-500/10',
      border: 'border-green-500/20',
    },
    {
      label: 'EVIDENCE TRUST',
      value: `${evidence?.verified || 0}/${evidence?.total || 0}`,
      subValue: `${Math.round((evidence?.verified || 0) / (evidence?.total || 1) * 100)}% verified`,
      icon: Shield,
      color: 'text-purple-400',
      bg: 'bg-purple-500/10',
      border: 'border-purple-500/20',
    },
  ];

  return (
    <div className="grid grid-cols-2 lg:grid-cols-4 gap-4">
      {cards.map((card, idx) => (
        <div
          key={idx}
          className={`bg-dark-card rounded-lg border ${card.border} p-4`}
        >
          <div className="flex items-start justify-between">
            <div>
              <p className="text-xs text-gray-500 font-medium">{card.label}</p>
              <p className="text-2xl font-bold text-white mt-1">{card.value}</p>
              <p className="text-xs text-gray-400 mt-1">{card.subValue}</p>
            </div>
            <div className={`p-2 rounded-lg ${card.bg}`}>
              <card.icon className={`w-5 h-5 ${card.color}`} />
            </div>
          </div>
        </div>
      ))}
    </div>
  );
};

export default IntelligenceKPICards;
