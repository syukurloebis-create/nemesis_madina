// AIStatusBar.tsx - Intelligence Status Bar
import React from 'react';
import { Activity, Database, Cpu, Shield, Users, AlertTriangle, Link, Briefcase } from 'lucide-react';

interface AIStatusBarProps {
  data: {
    executive?: any;
    cases?: any;
    evidence?: any;
    keyActors?: any[];
  };
}

export const AIStatusBar: React.FC<AIStatusBarProps> = ({ data }) => {
  const { executive, cases, evidence, keyActors } = data;
  
  const stats = [
    { label: 'ENTITIES', value: keyActors?.length || 0, icon: Users },
    { label: 'RELATIONSHIPS', value: 9, icon: Link },
    { label: 'COLLUSION SIGNALS', value: executive?.collusion_signals || 2, icon: AlertTriangle },
    { label: 'ACTIVE CASES', value: cases?.length || 0, icon: Briefcase },
  ];

  return (
    <header className="bg-dark-card border-b border-dark-border">
      <div className="max-w-7xl mx-auto px-4 py-3">
        <div className="flex flex-wrap items-center justify-between gap-4">
          {/* Logo & Title */}
          <div className="flex items-center gap-3">
            <div className="flex items-center gap-2">
              <Cpu className="w-6 h-6 text-blue-500" />
              <h1 className="text-xl font-bold bg-gradient-to-r from-blue-400 to-purple-500 bg-clip-text text-transparent">
                NEMESIS AI
              </h1>
            </div>
            <span className="text-xs font-mono text-gray-500">v8.0</span>
          </div>

          {/* Status Indicators */}
          <div className="flex flex-wrap items-center gap-3">
            <div className="flex items-center gap-1.5 px-3 py-1 bg-green-500/10 rounded-full border border-green-500/30">
              <div className="w-2 h-2 rounded-full bg-green-500 animate-pulse" />
              <span className="text-xs text-green-400">SYSTEM ACTIVE</span>
            </div>
            <div className="flex items-center gap-1.5 px-3 py-1 bg-blue-500/10 rounded-full border border-blue-500/30">
              <Cpu className="w-3 h-3 text-blue-400" />
              <span className="text-xs text-blue-400">AI ONLINE</span>
            </div>
            <div className="flex items-center gap-1.5 px-3 py-1 bg-purple-500/10 rounded-full border border-purple-500/30">
              <Database className="w-3 h-3 text-purple-400" />
              <span className="text-xs text-purple-400">DATA INGESTION</span>
            </div>
            <div className="text-xs text-gray-500 border-l border-dark-border pl-3">
              {new Date().toLocaleString('id-ID', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' })}
            </div>
          </div>

          {/* Stats */}
          <div className="flex items-center gap-4">
            {stats.map((stat, idx) => (
              <div key={idx} className="flex items-center gap-2">
                <stat.icon className="w-4 h-4 text-gray-500" />
                <div>
                  <span className="text-lg font-bold text-white">{stat.value}</span>
                  <span className="text-xs text-gray-500 ml-1">{stat.label}</span>
                </div>
                {idx < stats.length - 1 && <span className="w-px h-6 bg-dark-border" />}
              </div>
            ))}
          </div>
        </div>
      </div>
    </header>
  );
};

export default AIStatusBar;
