import React, { useEffect, useState } from 'react';
import { BrowserRouter, Routes, Route, Link, Navigate } from 'react-router-dom';
import { useAuthStore } from './stores/authStore';
import Login from './pages/Login';
import ExecutiveDashboard from './pages/ExecutiveDashboard';
import ThreatCenter from './pages/ThreatCenter';
import EntityWorkspace from './pages/EntityWorkspace';
import GraphIntelligence from './pages/GraphIntelligence';
import GovernanceCenter from './pages/GovernanceCenter';
import TemporalReplay from './pages/TemporalReplay';
import InvestigationCase from './pages/InvestigationCase';
import Analytics from './pages/Analytics';
import CommandCenter from './pages/CommandCenter';
import LiveAlerts from './pages/LiveAlerts';
import IntelligenceReport from './components/IntelligenceReport';

// Protected Route wrapper
const ProtectedRoute: React.FC<{ children: React.ReactNode; allowedRoles?: string[] }> = ({ 
  children, 
  allowedRoles 
}) => {
  const { isAuthenticated, user, isLoading, checkAuth } = useAuthStore();
  const [checked, setChecked] = useState(false);

  useEffect(() => {
    checkAuth().finally(() => setChecked(true));
  }, []);

  if (isLoading || !checked) {
    return (
      <div className="min-h-screen flex items-center justify-center">
        <div className="text-gray-500">Loading...</div>
      </div>
    );
  }

  if (!isAuthenticated) {
    return <Navigate to="/login" replace />;
  }

  if (allowedRoles && user && !allowedRoles.includes(user.role)) {
    return <Navigate to="/" replace />;
  }

  return <>{children}</>;
};

// Navigation Item Component
const NavItem: React.FC<{ to: string; icon: string; label: string; onClick?: () => void }> = ({ 
  to, icon, label, onClick 
}) => (
  <Link
    to={to}
    onClick={onClick}
    className="flex items-center gap-3 px-4 py-3 text-sm text-gray-700 rounded-lg hover:bg-gray-100 transition-colors"
  >
    <span className="text-lg">{icon}</span>
    <span>{label}</span>
  </Link>
);

// Dashboard Layout Component
const DashboardLayout: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const [sidebarOpen, setSidebarOpen] = useState(false);
  const { user, logout } = useAuthStore();

  const navItems = [
    { to: '/', icon: '📊', label: 'Executive Dashboard', roles: ['ADMIN', 'AUDITOR', 'INVESTIGATOR', 'PROSECUTOR', 'VIEWER'] },
    { to: '/threat', icon: '⚠️', label: 'Threat Intelligence', roles: ['ADMIN', 'AUDITOR', 'INVESTIGATOR'] },
    { to: '/entity', icon: '🏢', label: 'Entity Workspace', roles: ['ADMIN', 'AUDITOR', 'INVESTIGATOR'] },
    { to: '/graph', icon: '🕸️', label: 'Graph Intelligence', roles: ['ADMIN', 'INVESTIGATOR'] },
    { to: '/governance', icon: '⚖️', label: 'Governance Center', roles: ['ADMIN', 'AUDITOR'] },
    { to: '/temporal', icon: '⏰', label: 'Temporal Replay', roles: ['ADMIN', 'INVESTIGATOR'] },
    { to: '/investigation', icon: '🔍', label: 'Investigation Case', roles: ['ADMIN', 'INVESTIGATOR'] },
    { to: '/analytics', icon: '📈', label: 'Analytics', roles: ['ADMIN', 'AUDITOR'] },
    { to: '/alerts', icon: '🚨', label: 'Live Alerts', roles: ['ADMIN', 'INVESTIGATOR', 'AUDITOR'] },
    { to: '/command', icon: '🎮', label: 'Command Center', roles: ['ADMIN'] },
    { to: '/report', icon: '📊', label: 'Intelligence Report', roles: ['ADMIN', 'AUDITOR', 'INVESTIGATOR'] },
  ];

  const userRole = user?.role || 'VIEWER';
  const filteredNavItems = navItems.filter(item => item.roles.includes(userRole));

  return (
    <div className="min-h-screen bg-gray-50">
      {/* Mobile Header */}
      <div className="lg:hidden fixed top-0 left-0 right-0 bg-white border-b border-gray-200 z-50">
        <div className="flex items-center justify-between px-4 py-3">
          <button onClick={() => setSidebarOpen(!sidebarOpen)} className="p-2 rounded-lg hover:bg-gray-100">
            <svg className="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
          <h1 className="text-xl font-bold text-gray-900">NEMESIS V8</h1>
          <button onClick={() => logout()} className="p-2 rounded-lg hover:bg-gray-100" title="Logout">🚪</button>
        </div>
      </div>

      {/* Overlay */}
      {sidebarOpen && <div className="fixed inset-0 bg-black bg-opacity-50 z-40 lg:hidden" onClick={() => setSidebarOpen(false)} />}

      {/* Sidebar */}
      <aside className={`fixed top-0 left-0 h-full bg-white border-r border-gray-200 z-50 shadow-xl transition-transform duration-300 ease-in-out overflow-y-auto lg:translate-x-0 lg:w-64 lg:shadow-none w-80 ${sidebarOpen ? 'translate-x-0' : '-translate-x-full'}`}>
        <div className="p-4 border-b border-gray-200 sticky top-0 bg-white z-10">
          <div className="flex items-center justify-between">
            <div>
              <h1 className="text-xl font-bold text-gray-900">NEMESIS V8</h1>
              <p className="text-xs text-gray-500 mt-1">Intelligence Platform</p>
            </div>
            <button onClick={() => setSidebarOpen(false)} className="lg:hidden p-2 rounded-lg hover:bg-gray-100">✕</button>
          </div>
          <div className="mt-3 pt-3 border-t">
            <div className="flex items-center justify-between">
              <div>
                <p className="text-sm font-medium text-gray-900">{user?.full_name}</p>
                <p className="text-xs text-gray-500">{user?.role}</p>
              </div>
              <button onClick={() => logout()} className="text-sm text-red-600 hover:text-red-700">Logout</button>
            </div>
          </div>
        </div>
        <nav className="p-4 space-y-1 pb-20">
          {filteredNavItems.map((item) => (
            <NavItem key={item.to} to={item.to} icon={item.icon} label={item.label} onClick={() => setSidebarOpen(false)} />
          ))}
        </nav>
      </aside>

      {/* Main Content */}
      <main className="lg:ml-64 pt-14 lg:pt-0">
        <div className="container mx-auto px-4 py-4 lg:px-8 lg:py-6 max-w-7xl">
          {children}
        </div>
      </main>
    </div>
  );
};

function App() {
  const { isAuthenticated, checkAuth } = useAuthStore();
  const [checked, setChecked] = useState(false);

  useEffect(() => {
    checkAuth().finally(() => setChecked(true));
  }, []);

  if (!checked) {
    return (
      <div className="min-h-screen flex items-center justify-center">
        <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-green-500"></div>
      </div>
    );
  }

  if (!isAuthenticated) {
    return (
      <BrowserRouter>
        <Routes>
          <Route path="/login" element={<Login />} />
          <Route path="*" element={<Navigate to="/login" replace />} />
        </Routes>
      </BrowserRouter>
    );
  }

  return (
    <BrowserRouter>
      <Routes>
        <Route path="/login" element={<Navigate to="/" replace />} />
        <Route path="/" element={
          <ProtectedRoute allowedRoles={['ADMIN', 'AUDITOR', 'INVESTIGATOR', 'PROSECUTOR', 'VIEWER']}>
            <DashboardLayout><ExecutiveDashboard /></DashboardLayout>
          </ProtectedRoute>
        } />
        <Route path="/threat" element={
          <ProtectedRoute allowedRoles={['ADMIN', 'AUDITOR', 'INVESTIGATOR']}>
            <DashboardLayout><ThreatCenter /></DashboardLayout>
          </ProtectedRoute>
        } />
        <Route path="/entity" element={
          <ProtectedRoute allowedRoles={['ADMIN', 'AUDITOR', 'INVESTIGATOR']}>
            <DashboardLayout><EntityWorkspace /></DashboardLayout>
          </ProtectedRoute>
        } />
        <Route path="/graph" element={
          <ProtectedRoute allowedRoles={['ADMIN', 'INVESTIGATOR']}>
            <DashboardLayout><GraphIntelligence /></DashboardLayout>
          </ProtectedRoute>
        } />
        <Route path="/governance" element={
          <ProtectedRoute allowedRoles={['ADMIN', 'AUDITOR']}>
            <DashboardLayout><GovernanceCenter /></DashboardLayout>
          </ProtectedRoute>
        } />
        <Route path="/temporal" element={
          <ProtectedRoute allowedRoles={['ADMIN', 'INVESTIGATOR']}>
            <DashboardLayout><TemporalReplay /></DashboardLayout>
          </ProtectedRoute>
        } />
        <Route path="/investigation" element={
          <ProtectedRoute allowedRoles={['ADMIN', 'INVESTIGATOR']}>
            <DashboardLayout><InvestigationCase /></DashboardLayout>
          </ProtectedRoute>
        } />
        <Route path="/analytics" element={
          <ProtectedRoute allowedRoles={['ADMIN', 'AUDITOR']}>
            <DashboardLayout><Analytics /></DashboardLayout>
          </ProtectedRoute>
        } />
        <Route path="/alerts" element={
          <ProtectedRoute allowedRoles={['ADMIN', 'INVESTIGATOR', 'AUDITOR']}>
            <DashboardLayout><LiveAlerts /></DashboardLayout>
          </ProtectedRoute>
        } />
        <Route path="/command" element={
          <ProtectedRoute allowedRoles={['ADMIN']}>
            <DashboardLayout><CommandCenter /></DashboardLayout>
          </ProtectedRoute>
        } />
        <Route path="/report" element={
          <ProtectedRoute allowedRoles={['ADMIN', 'AUDITOR', 'INVESTIGATOR']}>
            <DashboardLayout><IntelligenceReport /></DashboardLayout>
          </ProtectedRoute>
        } />
      </Routes>
    </BrowserRouter>
  );
}

export default App;
