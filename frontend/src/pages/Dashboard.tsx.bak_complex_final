// Dashboard.tsx - Main Dashboard Page with Enhanced Network Graph
import React, { useState } from 'react';
import { useDashboardData } from '../hooks/useDashboardData';
import { KPICards } from '../components/dashboard/KPICards';
import { NetworkGraph } from '../components/network/NetworkGraph';
import { RiskReasoningPanel } from '../components/investigation/RiskReasoningPanel';
import { RecommendationCenter } from '../components/recommendation/RecommendationCenter';
import { ErrorBoundary } from '../components/common/ErrorBoundary';

const Dashboard: React.FC = () => {
  const [selectedCaseId] = useState('446e216d-eb0e-487e-8e6b-ec943468ea20');
  const { loading, error, data } = useDashboardData(selectedCaseId);

  if (loading) {
    return (
      <div className="flex items-center justify-center h-screen">
        <div className="text-center">
          <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600 mx-auto"></div>
          <p className="mt-4 text-gray-600">Memuat dasbor...</p>
        </div>
      </div>
    );
  }

  if (error) {
    return (
      <div className="flex items-center justify-center h-screen">
        <div className="bg-red-50 border border-red-200 rounded-lg p-6 text-red-600">
          <p className="font-semibold">⚠️ Error</p>
          <p>{error}</p>
        </div>
      </div>
    );
  }

  const {
    executive,
    evidence,
    keyActors,
  } = data;

  const riskLevel = executive?.risk_level || { score: 0, critical: 0, high: 0, medium: 0, low: 0 };
  const totalCases = riskLevel.critical + riskLevel.high + riskLevel.medium + riskLevel.low;

  const kpiData = {
    totalCases,
    criticalRisk: riskLevel.critical,
    highRisk: riskLevel.high,
    evidenceTotal: evidence?.total || 0,
    evidenceVerified: evidence?.verified || 0,
  };

  return (
    <div className="p-6 bg-gray-50 min-h-screen">
      <h1 className="text-2xl font-bold mb-6">NEMESIS V8+ Strategic Intelligence Center</h1>
      
      <KPICards data={kpiData} className="mb-6" />
      
      <ErrorBoundary fallback={<div className="text-red-500 p-4">Gagal memuat Network Graph</div>}>
        <NetworkGraph 
          actors={keyActors} 
          height={450}
          onNodeClick={(actor) => {
            console.log('Selected actor:', actor);
          }}
        />
      </ErrorBoundary>
      
      <div className="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-6">
        <ErrorBoundary fallback={<div className="text-red-500 p-4">Gagal memuat Risk Reasoning</div>}>
          <RiskReasoningPanel caseId={selectedCaseId} />
        </ErrorBoundary>
        
        <ErrorBoundary fallback={<div className="text-red-500 p-4">Gagal memuat Rekomendasi</div>}>
          <RecommendationCenter />
        </ErrorBoundary>
      </div>
    </div>
  );
};

export default Dashboard;
