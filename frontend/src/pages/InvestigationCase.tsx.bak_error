import React, { useState, useEffect } from 'react';
import { useAuthStore } from '../stores/authStore';
import EvidenceManager from '../components/case/EvidenceManager';
import SnapshotManager from "../components/forensic/SnapshotManager";
import StateComparison from "../components/forensic/StateComparison";
import ForensicTimeline from '../components/forensic/ForensicTimeline';

interface Case {
  id: string;
  title: string;
  description: string;
  status: string;
  priority: string;
  assigned_to: string | null;
  created_at: string;
  updated_at: string;
}

const InvestigationCase: React.FC = () => {
  const [cases, setCases] = useState<Case[]>([]);
  const [selectedCase, setSelectedCase] = useState<Case | null>(null);
  const [loading, setLoading] = useState(true);
  const [showTimeline, setShowTimeline] = useState(false);
  const [newCase, setNewCase] = useState({ title: '', description: '', priority: 'MEDIUM' });
  const { token } = useAuthStore();

  useEffect(() => {
    fetchCases();
  }, []);

  const fetchCases = async () => {
    try {
      setLoading(true);
      const response = await fetch('http://localhost/cases/', {
        headers: { 'Authorization': `Bearer ${token}` }
      });
      if (response.ok) {
        const data = await response.json();
        setCases(data.data || []);
      }
    } catch (error) {
      console.error('Failed to fetch cases:', error);
    } finally {
      setLoading(false);
    }
  };

  const createCase = async () => {
    if (!newCase.title) return;
    try {
      const response = await fetch('http://localhost/cases/', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify(newCase)
      });
      if (response.ok) {
        const data = await response.json();
        setCases([data.data || data, ...cases]);
        setNewCase({ title: '', description: '', priority: 'MEDIUM' });
      }
    } catch (error) {
      console.error('Failed to create case:', error);
    }
  };

  const updateCaseStatus = async (caseId: string, status: string) => {
    try {
      const response = await fetch(`http://localhost/cases/${caseId}/status`, {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify({ status })
      });
      if (response.ok) {
        setCases(cases.map(c => c.id === caseId ? { ...c, status } : c));
        if (selectedCase?.id === caseId) {
          setSelectedCase({ ...selectedCase, status });
        }
      }
    } catch (error) {
      console.error('Failed to update status:', error);
    }
  };

  const assignCase = async (caseId: string, assignee: string) => {
    try {
      const response = await fetch(`http://localhost/cases/${caseId}/assign`, {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify({ assignee })
      });
      if (response.ok) {
        setCases(cases.map(c => c.id === caseId ? { ...c, assigned_to: assignee, status: 'INVESTIGATING' } : c));
        if (selectedCase?.id === caseId) {
          setSelectedCase({ ...selectedCase, assigned_to: assignee, status: 'INVESTIGATING' });
        }
      }
    } catch (error) {
      console.error('Failed to assign case:', error);
    }
  };

  const getStatusColor = (status: string) => {
    switch (status?.toLowerCase()) {
      case 'open': return 'bg-yellow-500/20 text-yellow-400';
      case 'investigating': return 'bg-blue-500/20 text-blue-400';
      case 'verifying': return 'bg-purple-500/20 text-purple-400';
      case 'resolved': return 'bg-green-500/20 text-green-400';
      case 'closed': return 'bg-gray-500/20 text-gray-400';
      default: return 'bg-gray-500/20 text-gray-400';
    }
  };

  const getPriorityColor = (priority: string) => {
    switch (priority?.toLowerCase()) {
      case 'critical': return 'text-red-500 font-bold';
      case 'high': return 'text-orange-500';
      case 'medium': return 'text-yellow-500';
      default: return 'text-gray-400';
    }
  };

  if (loading) {
    return (
      <div className="flex items-center justify-center h-96">
        <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-green-500"></div>
      </div>
    );
  }

  return (
    <div className="space-y-6">
      <div className="bg-gray-800/50 rounded-xl p-4 border border-gray-700">
        <h1 className="text-2xl font-bold text-white">Investigation Case Management</h1>
        <p className="text-gray-400 text-sm mt-1">Manage cases, evidence, and forensic timeline</p>
      </div>

      {/* Create Case Form */}
      <div className="bg-gray-800 rounded-xl p-4 border border-gray-700">
        <h2 className="text-lg font-semibold text-white mb-4">Create New Case</h2>
        <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
          <input
            type="text"
            placeholder="Case Title"
            value={newCase.title}
            onChange={(e) => setNewCase({ ...newCase, title: e.target.value })}
            className="px-4 py-2 bg-gray-700 border border-gray-600 rounded-lg text-white"
          />
          <input
            type="text"
            placeholder="Description"
            value={newCase.description}
            onChange={(e) => setNewCase({ ...newCase, description: e.target.value })}
            className="px-4 py-2 bg-gray-700 border border-gray-600 rounded-lg text-white"
          />
          <select
            value={newCase.priority}
            onChange={(e) => setNewCase({ ...newCase, priority: e.target.value })}
            className="px-4 py-2 bg-gray-700 border border-gray-600 rounded-lg text-white"
          >
            <option value="LOW">Low</option>
            <option value="MEDIUM">Medium</option>
            <option value="HIGH">High</option>
            <option value="CRITICAL">Critical</option>
          </select>
        </div>
        <button
          onClick={createCase}
          className="mt-4 px-4 py-2 bg-green-500 text-white rounded-lg hover:bg-green-600"
        >
          Create Case
        </button>
      </div>

      {/* Cases List */}
      <div className="bg-gray-800 rounded-xl border border-gray-700 overflow-hidden">
        <div className="px-6 py-4 border-b border-gray-700">
          <h2 className="text-lg font-semibold text-white">Active Cases</h2>
        </div>
        <div className="divide-y divide-gray-700">
          {cases.length === 0 ? (
            <div className="p-8 text-center text-gray-500">No cases found</div>
          ) : (
            cases.map((caseItem) => (
              <div
                key={caseItem.id}
                className={`p-4 cursor-pointer hover:bg-gray-700/50 transition-colors ${selectedCase?.id === caseItem.id ? 'bg-gray-700/30' : ''}`}
                onClick={() => setSelectedCase(caseItem)}
              >
                <div className="flex justify-between items-start">
                  <div className="flex-1">
                    <div className="flex items-center gap-2">
                      <h3 className="font-semibold text-white">{caseItem.title}</h3>
                      <span className={`px-2 py-1 rounded-full text-xs ${getStatusColor(caseItem.status)}`}>
                        {caseItem.status}
                      </span>
                      <span className={`text-sm ${getPriorityColor(caseItem.priority)}`}>
                        {caseItem.priority}
                      </span>
                    </div>
                    <p className="text-sm text-gray-400 mt-1">{caseItem.description}</p>
                    <div className="flex gap-4 mt-2 text-xs text-gray-500">
                      <span>ID: {caseItem.id.slice(0, 8)}...</span>
                      <span>Created: {new Date(caseItem.created_at).toLocaleDateString()}</span>
                      {caseItem.assigned_to && <span>Assigned to: {caseItem.assigned_to}</span>}
                    </div>
                  </div>
                  <div className="flex gap-2">
                    <button
                      onClick={(e) => {
                        e.stopPropagation();
                        setSelectedCase(caseItem);
                        setShowTimeline(!showTimeline);
                      }}
                      className="px-3 py-1 text-xs bg-blue-500/20 text-blue-400 rounded-lg"
                    >
                      {showTimeline && selectedCase?.id === caseItem.id ? 'Hide Timeline' : 'View Timeline'}
                    </button>
                  </div>
                </div>

                {/* Expanded details */}
                {selectedCase?.id === caseItem.id && (
                  <div className="mt-4 pt-4 border-t border-gray-700 space-y-4">
                    {/* Case Actions */}
                    <div className="flex gap-3">
                      {caseItem.status === 'open' && (
                        <>
                          <button
                            onClick={() => assignCase(caseItem.id, 'investigator_01')}
                            className="px-3 py-1 text-sm bg-blue-500/20 text-blue-400 rounded-lg"
                          >
                            Assign to me
                          </button>
                          <button
                            onClick={() => updateCaseStatus(caseItem.id, 'INVESTIGATING')}
                            className="px-3 py-1 text-sm bg-purple-500/20 text-purple-400 rounded-lg"
                          >
                            Start Investigation
                          </button>
                        </>
                      )}
                      {caseItem.status === 'investigating' && (
                        <>
                          <button
                            onClick={() => updateCaseStatus(caseItem.id, 'VERIFYING')}
                            className="px-3 py-1 text-sm bg-yellow-500/20 text-yellow-400 rounded-lg"
                          >
                            Send to Verification
                          </button>
                          <button
                            onClick={() => updateCaseStatus(caseItem.id, 'RESOLVED')}
                            className="px-3 py-1 text-sm bg-green-500/20 text-green-400 rounded-lg"
                          >
                            Resolve
                          </button>
                        </>
                      )}
                      {caseItem.status === 'verifying' && (
                        <button
                          onClick={() => updateCaseStatus(caseItem.id, 'RESOLVED')}
                          className="px-3 py-1 text-sm bg-green-500/20 text-green-400 rounded-lg"
                        >
                          Approve & Resolve
                        </button>
                      )}
                    </div>

                    {/* Evidence Manager */}
                    <EvidenceManager caseId={caseItem.id} />

                    {/* Forensic Timeline */}
                    {showTimeline && (
                      <div className="mt-4">
                        <h4 className="font-semibold text-white mb-3">Forensic Timeline</h4>
                        <ForensicTimeline caseId={caseItem.id} />
                      </div>
                    )}
                  </div>
                )}
              </div>
            ))
          )}
        </div>
      </div>
    </div>
  );
};

export default InvestigationCase;

      {/* Forensic Tools Tabs */}
      {selectedCase && (
        <div className="mt-4">
          <div className="border-b border-gray-700">
            <nav className="flex gap-6">
              <button className="pb-2 px-1 text-sm font-medium text-green-400 border-b-2 border-green-400">
                Evidence
              </button>
              <button className="pb-2 px-1 text-sm font-medium text-gray-400 hover:text-gray-300">
                Snapshots
              </button>
              <button className="pb-2 px-1 text-sm font-medium text-gray-400 hover:text-gray-300">
                State Comparison
              </button>
            </nav>
          </div>
          <div className="mt-4">
            <EvidenceManager caseId={selectedCase.id} />
          </div>
        </div>
      )}
