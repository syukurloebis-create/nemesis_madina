import { ErrorBoundary } from "../components/common/ErrorBoundary";
import React from 'react';
import { 
  Activity, 
  AlertTriangle, 
  TrendingUp, 
  TrendingDown,
  Shield,
  CheckCircle,
  Clock
} from 'lucide-react';
import { useExecutiveOverview, useEvidenceStats, useGovernanceMetrics } from '../hooks/useDashboard';
                <ErrorBoundary fallback={<div className="text-red-500 p-4">Gagal memuat Risk Reasoning</div>}>
import { RiskReasoningPanel } from '../components/investigation/RiskReasoningPanel';
                <RecommendationCenter />
                </ErrorBoundary>
                <ErrorBoundary fallback={<div className="text-red-500 p-4">Gagal memuat Rekomendasi</div>}>
import { RecommendationCenter } from '../components/recommendation/RecommendationCenter';
                </ErrorBoundary>

const formatCurrency = (value: number) => {
  return new Intl.NumberFormat('id-ID', { 
    style: 'currency', 
    currency: 'IDR', 
    minimumFractionDigits: 0,
    maximumFractionDigits: 0
  }).format(value || 0);
};

export const Dashboard: React.FC = () => {
  const { data: executive, isLoading: execLoading } = useExecutiveOverview();
  const { data: evidence, isLoading: evidLoading } = useEvidenceStats();
  const { data: governance, isLoading: govLoading } = useGovernanceMetrics();

  const loading = execLoading || evidLoading || govLoading;

  if (loading) {
    return (
      <div className="flex items-center justify-center h-64">
        <div className="text-center">
          <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600 mx-auto"></div>
          <p className="mt-4 text-gray-600">Memuat dasbor...</p>
        </div>
      </div>
    );
  }

  const riskLevel = executive?.risk_level || { score: 0, critical: 0, high: 0, medium: 0, low: 0 };
  const totalCases = riskLevel.critical + riskLevel.high + riskLevel.medium + riskLevel.low;

  return (
    <div className="space-y-6">
      {/* Header */}
      <div>
        <h1 className="text-3xl font-bold text-gray-800">🏛️ NEMESIS V8+</h1>
        <p className="text-gray-500">Strategic Intelligence Center</p>
      </div>

      {/* KPI Cards */}
      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                <ErrorBoundary fallback={<div className="text-red-500 p-4">Gagal memuat Risk Reasoning</div>}>
                <RiskReasoningPanel caseId={selectedCaseId || caseId} />
                <RecommendationCenter />
                </ErrorBoundary>
        <div className="bg-white rounded-lg shadow p-6 border-l-4 border-blue-500">
          <div className="flex items-center justify-between">
            <div>
              <p className="text-sm text-gray-500">Total Kasus</p>
              <p className="text-2xl font-bold">{totalCases}</p>
            </div>
            <Activity className="text-blue-500" size={32} />
          </div>
          <div className="mt-2 flex gap-1">
            {riskLevel.critical > 0 && (
              <span className="text-xs px-2 py-1 bg-red-100 text-red-700 rounded">Kritis: {riskLevel.critical}</span>
            )}
            {riskLevel.high > 0 && (
              <span className="text-xs px-2 py-1 bg-orange-100 text-orange-700 rounded">Tinggi: {riskLevel.high}</span>
            )}
          </div>
        </div>

        <div className="bg-white rounded-lg shadow p-6 border-l-4 border-red-500">
          <div className="flex items-center justify-between">
            <div>
              <p className="text-sm text-gray-500">Skor Risiko</p>
              <p className="text-2xl font-bold">{riskLevel.score.toFixed(1)}</p>
            </div>
            <AlertTriangle className="text-red-500" size={32} />
          </div>
          <p className="text-sm text-gray-500 mt-2">
            {riskLevel.score >= 80 ? '⚠️ Risiko Tinggi' : '✅ Risiko Terkendali'}
          </p>
        </div>

        <div className="bg-white rounded-lg shadow p-6 border-l-4 border-orange-500">
          <div className="flex items-center justify-between">
            <div>
              <p className="text-sm text-gray-500">Eksposur</p>
              <p className="text-lg font-bold">{formatCurrency(executive?.exposure || 0)}</p>
            </div>
            <TrendingUp className="text-orange-500" size={32} />
          </div>
          <p className="text-sm text-gray-500 mt-2">Potensi kerugian</p>
        </div>

        <div className="bg-white rounded-lg shadow p-6 border-l-4 border-green-500">
          <div className="flex items-center justify-between">
            <div>
              <p className="text-sm text-gray-500">Pemulihan</p>
              <p className="text-lg font-bold">{formatCurrency(executive?.recovery || 0)}</p>
            </div>
            <TrendingDown className="text-green-500" size={32} />
          </div>
          <p className="text-sm text-gray-500 mt-2">Nilai berhasil dipulihkan</p>
        </div>
      </div>

      {/* Evidence & Governance */}
      <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div className="bg-white rounded-lg shadow p-6">
          <h3 className="text-lg font-semibold mb-4">📎 Intelijen Bukti</h3>
          <div className="grid grid-cols-3 gap-4 text-center">
            <div>
              <p className="text-2xl font-bold text-blue-600">{evidence?.total || 0}</p>
              <p className="text-sm text-gray-500">Total</p>
            </div>
            <div>
              <p className="text-2xl font-bold text-green-600">{evidence?.verified || 0}</p>
              <p className="text-sm text-gray-500">Terverifikasi</p>
            </div>
            <div>
              <p className="text-2xl font-bold text-yellow-600">{evidence?.pending || 0}</p>
              <p className="text-sm text-gray-500">Pending</p>
            </div>
          </div>
        </div>

        <div className="bg-white rounded-lg shadow p-6">
          <h3 className="text-lg font-semibold mb-4">🏛️ Governance APIP</h3>
          <div className="grid grid-cols-2 gap-4">
            <div className="text-center p-3 bg-blue-50 rounded-lg">
              <p className="text-2xl font-bold text-blue-600">{governance?.spip_maturity || 0}%</p>
              <p className="text-sm text-gray-500">SPIP Maturity</p>
            </div>
            <div className="text-center p-3 bg-green-50 rounded-lg">
              <p className="text-2xl font-bold text-green-600">{governance?.follow_up_completion || 0}%</p>
              <p className="text-sm text-gray-500">Tindak Lanjut</p>
            </div>
          </div>
        </div>
      </div>

      {/* Status */}
      <div className="text-center text-gray-400 text-xs pt-4 border-t">
        <p>NEMESIS V8+ - Strategic Intelligence Center | Data terverifikasi hash chain</p>
        <p>Terakhir diperbarui: {new Date().toLocaleString('id-ID')}</p>
      </div>
    </div>
  );
};
