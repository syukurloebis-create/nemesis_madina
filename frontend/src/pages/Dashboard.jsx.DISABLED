import React, { useEffect, useState } from 'react';
import axios from 'axios';
import MetricCard from '../components/KPI/MetricCard';
import RiskTrendChart from '../components/Charts/RiskTrendChart';

const API_BASE = 'http://localhost:8000';

const Dashboard = () => {
    const [loading, setLoading] = useState(true);
    const [data, setData] = useState({
        summary: { total_cases: 0, high_risk_cases: 0, total_loss: 0, recovery_rate: 0 },
        risk_trend: []
    });
    const [error, setError] = useState(null);

    useEffect(() => {
        fetchDashboardData();
    }, []);

    const fetchDashboardData = async () => {
        try {
            setError(null);
            
            // Fetch strategic dashboard
            const strategicRes = await axios.get(`${API_BASE}/strategic/dashboard`);
            
            // Fetch risk trend
            const riskRes = await axios.get(`${API_BASE}/predictive/risk/trend?days=30`);
            
            setData({
                summary: strategicRes.data.summary || { total_cases: 0, high_risk_cases: 0, total_loss: 0, recovery_rate: 0 },
                risk_trend: riskRes.data.historical || []
            });
        } catch (err) {
            console.error('Error fetching dashboard data:', err);
            setError('Gagal memuat data dashboard');
        } finally {
            setLoading(false);
        }
    };

    const formatCurrency = (value) => {
        if (!value) return 'Rp0';
        return new Intl.NumberFormat('id-ID', { 
            style: 'currency', 
            currency: 'IDR', 
            minimumFractionDigits: 0,
            maximumFractionDigits: 0 
        }).format(value);
    };

    const summary = data.summary || {};

    return (
        <div style={{ 
            minHeight: '100vh', 
            background: '#0a0e1a',
            color: '#fff',
            padding: '24px',
            fontFamily: 'Arial, sans-serif'
        }}>
            {/* Header */}
            <div style={{ 
                display: 'flex', 
                justifyContent: 'space-between', 
                alignItems: 'center',
                marginBottom: '32px',
                borderBottom: '1px solid #2a2a4a',
                paddingBottom: '16px'
            }}>
                <div>
                    <h1 style={{ margin: 0, color: '#1976d2', fontSize: '24px' }}>
                        ⚡ NEMESIS V8+
                    </h1>
                    <p style={{ margin: '4px 0 0', color: '#666', fontSize: '14px' }}>
                        STRATEGIC INTELLIGENCE CENTER
                    </p>
                </div>
                <div style={{ display: 'flex', gap: '12px' }}>
                    <span style={{ 
                        padding: '6px 16px', 
                        background: '#151929', 
                        borderRadius: '20px',
                        fontSize: '12px',
                        border: '1px solid #2a2a4a'
                    }}>
                        🟢 System Online
                    </span>
                    <span style={{ 
                        padding: '6px 16px', 
                        background: '#151929', 
                        borderRadius: '20px',
                        fontSize: '12px',
                        border: '1px solid #2a2a4a'
                    }}>
                        {new Date().toLocaleString('id-ID')}
                    </span>
                </div>
            </div>

            {/* Row 1: KPI Cards */}
            <div style={{ display: 'grid', gridTemplateColumns: 'repeat(4, 1fr)', gap: '16px', marginBottom: '24px' }}>
                <MetricCard 
                    title="Total Kasus" 
                    value={summary.total_cases || 0} 
                    subtitle="Kasus Aktif"
                    loading={loading}
                />
                <MetricCard 
                    title="Risiko Tinggi" 
                    value={summary.high_risk_cases || 0} 
                    subtitle="Perlu Perhatian Segera"
                    color="#d32f2f"
                    loading={loading}
                />
                <MetricCard 
                    title="Potensi Kerugian" 
                    value={formatCurrency(summary.total_loss)} 
                    subtitle="Estimasi Kerugian"
                    color="#ff9800"
                    loading={loading}
                />
                <MetricCard 
                    title="Tingkat Pemulihan" 
                    value={summary.recovery_rate || 0} 
                    subtitle="% Pemulihan"
                    color="#4caf50"
                    loading={loading}
                />
            </div>

            {/* Row 2: Charts */}
            <div style={{ display: 'grid', gridTemplateColumns: '2fr 1fr', gap: '16px', marginBottom: '24px' }}>
                <RiskTrendChart data={data.risk_trend} loading={loading} />
                
                {/* Quick Stats */}
                <div style={{ 
                    padding: '20px', 
                    background: '#151929', 
                    borderRadius: '12px', 
                    border: '1px solid #2a2a4a'
                }}>
                    <h3 style={{ margin: '0 0 16px', fontSize: '16px', color: '#fff' }}>⚙️ System Status</h3>
                    <div style={{ marginBottom: '12px' }}>
                        <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: '8px' }}>
                            <span style={{ color: '#666' }}>Integrity</span>
                            <span style={{ fontWeight: 'bold', color: '#4caf50' }}>100%</span>
                        </div>
                        <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: '8px' }}>
                            <span style={{ color: '#666' }}>Evidence Trust</span>
                            <span style={{ fontWeight: 'bold', color: '#4caf50' }}>96%</span>
                        </div>
                        <div style={{ display: 'flex', justifyContent: 'space-between' }}>
                            <span style={{ color: '#666' }}>Hash Chain</span>
                            <span style={{ fontWeight: 'bold', color: '#4caf50' }}>Verified ✓</span>
                        </div>
                    </div>
                    <div style={{ 
                        padding: '12px', 
                        background: 'rgba(25, 118, 210, 0.1)', 
                        borderRadius: '8px',
                        border: '1px solid rgba(25, 118, 210, 0.2)'
                    }}>
                        <div style={{ fontSize: '12px', color: '#666' }}>Active Investigations</div>
                        <div style={{ fontSize: '20px', fontWeight: 'bold' }}>{summary.total_cases || 0}</div>
                    </div>
                </div>
            </div>

            {/* Footer */}
            <div style={{ 
                marginTop: '32px', 
                padding: '16px', 
                textAlign: 'center', 
                borderTop: '1px solid #2a2a4a',
                color: '#444',
                fontSize: '12px'
            }}>
                NEMESIS V8+ Strategic Intelligence Center | Integrity: 100% | {new Date().toLocaleString('id-ID')}
            </div>
        </div>
    );
};

export default Dashboard;
