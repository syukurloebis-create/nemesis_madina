# Production Environment
ENVIRONMENT=production
DEBUG=false

# Database
DATABASE_URL=postgresql+asyncpg://nemesis:nemesis123@localhost:5432/nemesis_db

# JWT
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# Redis Cache
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=300

# CORS Production
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# Logging
LOG_LEVEL=ERROR
LOG_FILE=/var/log/nemesis/app.log
