{
  "dashboard": {
    "title": "Nemesis Madina V8+ - Production Dashboard",
    "uid": "nemesis-production-v2",
    "tags": ["nemesis", "production", "audit"],
    "timezone": "browser",
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "API Health Status",
        "type": "stat",
        "gridPos": {"h": 4, "w": 3, "x": 0, "y": 0},
        "targets": [{
          "expr": "sum(up{job=\"nemesis_api\"})",
          "legendFormat": "Healthy APIs"
        }],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "steps": [
                {"color": "red", "value": null},
                {"color": "orange", "value": 1},
                {"color": "green", "value": 2}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "System Uptime",
        "type": "stat",
        "gridPos": {"h": 4, "w": 3, "x": 3, "y": 0},
        "targets": [{
          "expr": "(time() - process_start_time_seconds{job=\"nemesis_api\"})",
          "legendFormat": "Uptime (seconds)"
        }],
        "fieldConfig": {"defaults": {"unit": "s"}}
      },
      {
        "id": 3,
        "title": "Total Cases",
        "type": "stat",
        "gridPos": {"h": 4, "w": 3, "x": 6, "y": 0},
        "targets": [{
          "expr": "nemesis_total_cases or vector(0)",
          "legendFormat": "Total Cases"
        }]
      },
      {
        "id": 4,
        "title": "API Response Time (p95)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
        "targets": [{
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 latency"
        }],
        "fieldConfig": {"defaults": {"unit": "s"}}
      },
      {
        "id": 5,
        "title": "Cases by Priority",
        "type": "piechart",
        "gridPos": {"h": 8, "w": 6, "x": 12, "y": 4},
        "targets": [{
          "expr": "count by (priority) (nemesis_cases_by_priority) or vector(0)",
          "legendFormat": "{{priority}}"
        }]
      }
    ]
  },
  "overwrite": true
}
