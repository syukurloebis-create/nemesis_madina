{
  "devDependencies": {
    "@types/node": "^20.19.43",
    "dependency-cruiser": "^16.10.4",
    "eslint-plugin-import": "^2.29.0",
    "madge": "^6.0.0",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "check:dep": "dependency-cruiser packages/**/*.ts",
    "check:cycle": "madge --circular packages/**/*.ts",
    "check:all": "npm run check:dep && npm run check:cycle"
  }
}
