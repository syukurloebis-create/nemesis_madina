# routers/evidence.py - Evidence Upload (FIXED - NAMED PARAMETERS)
from fastapi import APIRouter, Depends, HTTPException, Query, UploadFile, File, Form
from sqlalchemy.ext.asyncio import AsyncSession
from sqlalchemy import text
from backend.database import get_db
import json
import uuid
import hashlib
import os
import aiofiles
import logging
from typing import Optional

logger = logging.getLogger(__name__)

router = APIRouter(prefix="/api/v1/evidence", tags=["evidence"])

@router.post("/upload")
async def upload_evidence(
    file: UploadFile = File(...),
    case_id: str = Form(...),
    title: Optional[str] = Form(None),
    description: Optional[str] = Form(None),
    evidence_type: Optional[str] = Form("document"),
    db: AsyncSession = Depends(get_db)
):
    try:
        evidence_id = str(uuid.uuid4())
        content = await file.read()
        file_size = len(content)
        sha256_hash = hashlib.sha256(content).hexdigest()
        
        upload_dir = "storage/uploads"
        os.makedirs(upload_dir, exist_ok=True)
        file_path = f"{upload_dir}/{evidence_id}_{file.filename}"
        
        async with aiofiles.open(file_path, "wb") as f:
            await f.write(content)
        
        trust_score = 50.0
        if file.content_type in ["application/pdf", "image/png", "image/jpeg"]:
            trust_score = 70.0
        if file.content_type == "application/pdf":
            trust_score = 80.0
        
        scoring_detail = json.dumps({
            "file_type_score": trust_score,
            "hash_verified": False,
            "integrity_check": "pending"
        })
        
        # ============================================================
        # QUERY 1: INSERT EVIDENCE - HANYA NAMED PARAMETER
        # ============================================================
        query = """
            INSERT INTO evidence (
                id, case_id, filename, file_type, file_size,
                file_hash, trust_score, status, uploaded_at,
                updated_at, scoring_detail
            )
            VALUES (
                :evidence_id, :case_id, :filename, :file_type, :file_size,
                :file_hash, :trust_score,
                'UPLOADED',
                NOW(),
                NOW(),
                CAST(:scoring_detail AS jsonb)
            )
            RETURNING id
        """
        
        result = await db.execute(
            text(query),
            {
                "evidence_id": evidence_id,
                "case_id": case_id,
                "filename": file.filename,
                "file_type": file.content_type,
                "file_size": file_size,
                "file_hash": sha256_hash,
                "trust_score": trust_score,
                "scoring_detail": scoring_detail
            }
        )
        
        # ============================================================
        # QUERY 2: INSERT CUSTODY - HANYA NAMED PARAMETER
        # ============================================================
        custody_query = """
            INSERT INTO custody_events (
                id, evidence_id, action, actor, timestamp, notes, metadata
            )
            VALUES (
                gen_random_uuid(), :evidence_id, 'UPLOAD', 'System',
                NOW(), 'Evidence uploaded to system',
                CAST(:metadata AS jsonb)
            )
            RETURNING id
        """
        
        metadata_json = json.dumps({
            "filename": file.filename,
            "file_type": file.content_type,
            "file_size": file_size,
            "sha256": sha256_hash,
            "uploaded_by": "system"
        })
        
        await db.execute(
            text(custody_query),
            {
                "evidence_id": evidence_id,
                "metadata": metadata_json
            }
        )
        
        await db.commit()
        
        return {
            "id": evidence_id,
            "filename": file.filename,
            "file_hash": sha256_hash,
            "trust_score": trust_score,
            "status": "UPLOADED",
            "message": "Evidence uploaded successfully"
        }
        
    except Exception as e:
        await db.rollback()
        logger.error(f"Error uploading evidence: {str(e)}")
        raise HTTPException(status_code=500, detail=str(e))
