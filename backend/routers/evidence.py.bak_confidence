# routers/evidence.py - Evidence endpoints (FIXED PATH)
from fastapi import APIRouter, Depends, HTTPException, Query, UploadFile, File, Form
from sqlalchemy.ext.asyncio import AsyncSession
from sqlalchemy import text
from backend.database import get_db
import json
import uuid
import hashlib
import os
import aiofiles
import glob
import logging
from pathlib import Path
from typing import Optional

logger = logging.getLogger(__name__)

router = APIRouter(prefix="/api/v1/evidence", tags=["evidence"])

# ============================================================
# PATH CONFIGURATION - Konsisten untuk upload & verify
# ============================================================

BASE_DIR = Path(__file__).resolve().parent.parent  # /app/backend
UPLOAD_DIR = BASE_DIR / "storage" / "uploads"
UPLOAD_DIR.mkdir(parents=True, exist_ok=True)

logger.info(f"📁 Evidence upload directory: {UPLOAD_DIR}")


# ============================================================
# ENDPOINT 1: UPLOAD EVIDENCE
# ============================================================

@router.post("/upload")
async def upload_evidence(
    file: UploadFile = File(...),
    case_id: str = Form(...),
    title: Optional[str] = Form(None),
    description: Optional[str] = Form(None),
    evidence_type: Optional[str] = Form("document"),
    db: AsyncSession = Depends(get_db)
):
    try:
        evidence_id = str(uuid.uuid4())
        content = await file.read()
        file_size = len(content)
        sha256_hash = hashlib.sha256(content).hexdigest()

        # Gunakan UPLOAD_DIR yang konsisten
        file_path = UPLOAD_DIR / f"{evidence_id}_{file.filename}"

        async with aiofiles.open(str(file_path), "wb") as f:
            await f.write(content)

        trust_score = 50.0
        if file.content_type in ["application/pdf", "image/png", "image/jpeg"]:
            trust_score = 70.0
        if file.content_type == "application/pdf":
            trust_score = 80.0

        scoring_detail = json.dumps({
            "file_type_score": trust_score,
            "hash_verified": False,
            "integrity_check": "pending"
        })

        query = """
            INSERT INTO evidence (
                id, case_id, filename, file_type, file_size,
                file_hash, trust_score, status, uploaded_at,
                updated_at, scoring_detail
            )
            VALUES (
                :evidence_id, :case_id, :filename, :file_type, :file_size,
                :file_hash, :trust_score,
                'UPLOADED',
                NOW(),
                NOW(),
                CAST(:scoring_detail AS jsonb)
            )
            RETURNING id
        """

        await db.execute(
            text(query),
            {
                "evidence_id": evidence_id,
                "case_id": case_id,
                "filename": file.filename,
                "file_type": file.content_type,
                "file_size": file_size,
                "file_hash": sha256_hash,
                "trust_score": trust_score,
                "scoring_detail": scoring_detail
            }
        )

        custody_query = """
            INSERT INTO custody_events (
                id, evidence_id, action, actor, timestamp, notes, metadata
            )
            VALUES (
                gen_random_uuid(), :evidence_id, 'UPLOAD', 'System',
                NOW(), 'Evidence uploaded to system',
                CAST(:metadata AS jsonb)
            )
            RETURNING id
        """

        metadata_json = json.dumps({
            "filename": file.filename,
            "file_type": file.content_type,
            "file_size": file_size,
            "sha256": sha256_hash,
            "uploaded_by": "system"
        })

        await db.execute(
            text(custody_query),
            {
                "evidence_id": evidence_id,
                "metadata": metadata_json
            }
        )

        await db.commit()

        return {
            "id": evidence_id,
            "filename": file.filename,
            "file_hash": sha256_hash,
            "trust_score": trust_score,
            "status": "UPLOADED",
            "message": "Evidence uploaded successfully"
        }

    except Exception as e:
        await db.rollback()
        logger.error(f"Error uploading evidence: {str(e)}")
        raise HTTPException(status_code=500, detail=str(e))


# ============================================================
# ENDPOINT 2: EVIDENCE STATS
# ============================================================

@router.get("/stats")
async def get_evidence_stats(db: AsyncSession = Depends(get_db)):
    try:
        result = await db.execute(text("""
            SELECT 
                COUNT(*) as total,
                COUNT(CASE WHEN status = 'VERIFIED' THEN 1 END) as verified,
                COUNT(CASE WHEN status = 'UPLOADED' THEN 1 END) as pending,
                COUNT(CASE WHEN status = 'REJECTED' THEN 1 END) as rejected
            FROM evidence
        """))
        row = result.fetchone()
        return {
            "total": row[0] or 0,
            "verified": row[1] or 0,
            "pending": row[2] or 0,
            "rejected": row[3] or 0
        }
    except Exception as e:
        logger.error(f"Error getting evidence stats: {str(e)}")
        raise HTTPException(status_code=500, detail=str(e))


# ============================================================
# ENDPOINT 3: TOP EVIDENCE
# ============================================================

@router.get("/top")
async def get_top_evidence(
    limit: int = Query(10, ge=1, le=50),
    db: AsyncSession = Depends(get_db)
):
    try:
        query = """
            SELECT 
                e.id, e.case_id, e.filename, e.file_type,
                e.trust_score, e.status, e.verified_at, e.uploaded_at,
                c.title as case_title
            FROM evidence e
            LEFT JOIN cases c ON e.case_id = c.id::text
            WHERE e.trust_score IS NOT NULL
            ORDER BY e.trust_score DESC
            LIMIT :limit
        """
        result = await db.execute(text(query), {"limit": limit})
        rows = result.fetchall()
        return [
            {
                "id": str(row[0]),
                "case_id": str(row[1]) if row[1] else None,
                "filename": row[2],
                "file_type": row[3],
                "trust_score": float(row[4]) if row[4] is not None else 0,
                "status": row[5],
                "verified_at": row[6].isoformat() if row[6] else None,
                "uploaded_at": row[7].isoformat() if row[7] else None,
                "case_title": row[8]
            }
            for row in rows
        ]
    except Exception as e:
        logger.error(f"Error getting top evidence: {str(e)}")
        raise HTTPException(status_code=500, detail=str(e))


# ============================================================
# ENDPOINT 4: EVIDENCE CHAIN
# ============================================================

@router.get("/{evidence_id}/chain")
async def get_evidence_chain(
    evidence_id: str,
    db: AsyncSession = Depends(get_db)
):
    try:
        ev_query = """
            SELECT 
                id, case_id, filename, file_type, file_size,
                file_hash, trust_score, status, verified_at,
                uploaded_at, updated_at, scoring_detail, confidence_level
            FROM evidence
            WHERE id = :evidence_id
        """
        ev_result = await db.execute(text(ev_query), {"evidence_id": evidence_id})
        ev_row = ev_result.fetchone()
        
        if not ev_row:
            raise HTTPException(status_code=404, detail="Evidence not found")
        
        custody_query = """
            SELECT id, evidence_id, action, actor, timestamp, notes, metadata
            FROM custody_events
            WHERE evidence_id = :evidence_id
            ORDER BY timestamp ASC
        """
        custody_result = await db.execute(text(custody_query), {"evidence_id": evidence_id})
        custody_rows = custody_result.fetchall()
        
        custody_events = [
            {
                "id": str(row[0]),
                "evidence_id": str(row[1]),
                "action": row[2],
                "actor": row[3],
                "timestamp": row[4].isoformat() if row[4] else None,
                "notes": row[5],
                "metadata": row[6] or {}
            }
            for row in custody_rows
        ]
        
        integrity = 0
        if len(custody_events) >= 1:
            integrity = 50
        if any(e["action"] == "VERIFY" for e in custody_events):
            integrity = 85
        if len(custody_events) >= 3:
            integrity = 95
        
        return {
            "evidence": {
                "id": str(ev_row[0]),
                "case_id": str(ev_row[1]) if ev_row[1] else None,
                "filename": ev_row[2],
                "file_type": ev_row[3],
                "file_size": ev_row[4],
                "file_hash": ev_row[5],
                "trust_score": float(ev_row[6]) if ev_row[6] else 0,
                "status": ev_row[7],
                "verified_at": ev_row[8].isoformat() if ev_row[8] else None,
                "uploaded_at": ev_row[9].isoformat() if ev_row[9] else None,
                "updated_at": ev_row[10].isoformat() if ev_row[10] else None,
                "scoring_detail": ev_row[11] or {},
                "confidence_level": ev_row[12]
            },
            "custody_events": custody_events,
            "summary": {
                "total_events": len(custody_events),
                "unique_actors": list({e["actor"] for e in custody_events if e["actor"]}),
                "actions": {e["action"]: sum(1 for x in custody_events if x["action"] == e["action"]) for e in custody_events},
                "chain_integrity": integrity
            }
        }
    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"Error getting evidence chain: {str(e)}")
        raise HTTPException(status_code=500, detail=str(e))


# ============================================================
# ENDPOINT 5: VERIFY EVIDENCE - WITH CUSTODY EVENT (FIXED PATH)
# ============================================================

@router.post("/{evidence_id}/verify")
async def verify_evidence(
    evidence_id: str,
    db: AsyncSession = Depends(get_db)
):
    try:
        # Get current evidence
        get_query = "SELECT id, file_hash, status, trust_score FROM evidence WHERE id = :evidence_id"
        result = await db.execute(text(get_query), {"evidence_id": evidence_id})
        row = result.fetchone()
        
        if not row:
            raise HTTPException(status_code=404, detail="Evidence not found")
        
        # Find file using UPLOAD_DIR
        files = list(UPLOAD_DIR.glob(f"{evidence_id}_*"))
        if not files:
            raise HTTPException(
                status_code=404,
                detail=f"File not found in {UPLOAD_DIR}"
            )
        
        # Read and verify hash
        file_path = str(files[0])
        async with aiofiles.open(file_path, "rb") as f:
            content = await f.read()
            current_hash = hashlib.sha256(content).hexdigest()
        
        is_verified = current_hash == row[1]
        new_status = "VERIFIED" if is_verified else "REJECTED"
        new_trust = min(float(row[3]) + 20, 100) if is_verified else max(float(row[3]) - 30, 0)
        
        # Update evidence
        update_query = """
            UPDATE evidence 
            SET status = :status,
                trust_score = :trust_score,
                verified_at = NOW(),
                updated_at = NOW(),
                scoring_detail = jsonb_set(
                    scoring_detail,
                    '{hash_verified}',
                    CAST(:hash_verified AS jsonb)
                )
            WHERE id = :evidence_id
            RETURNING id
        """
        
        await db.execute(
            text(update_query),
            {
                "status": new_status,
                "trust_score": new_trust,
                "hash_verified": "true" if is_verified else "false",
                "evidence_id": evidence_id
            }
        )
        
        # Insert custody event for VERIFY
        custody_query = """
            INSERT INTO custody_events (
                id, evidence_id, action, actor, timestamp, notes, metadata
            )
            VALUES (
                gen_random_uuid(), :evidence_id, 'VERIFY', 'AI',
                NOW(), :notes,
                CAST(:metadata AS jsonb)
            )
            RETURNING id
        """
        
        custody_notes = f"Evidence verification {'successful' if is_verified else 'failed'}"
        custody_metadata = json.dumps({
            "verified_by": "AI",
            "hash_match": is_verified,
            "trust_score": float(new_trust),
            "previous_hash": row[1],
            "current_hash": current_hash
        })
        
        await db.execute(
            text(custody_query),
            {
                "evidence_id": evidence_id,
                "notes": custody_notes,
                "metadata": custody_metadata
            }
        )
        
        await db.commit()
        
        return {
            "id": evidence_id,
            "status": new_status,
            "trust_score": new_trust,
            "verified": is_verified,
            "message": f"Evidence {new_status.lower()}"
        }
        
    except Exception as e:
        await db.rollback()
        logger.error(f"Error verifying evidence: {str(e)}")
        raise HTTPException(status_code=500, detail=str(e))


