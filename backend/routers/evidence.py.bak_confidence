@router.get("/case/{case_id}")
async def get_evidence_by_case(
    case_id: str,
    db: AsyncSession = Depends(get_db)
):
    try:
        query = """
            SELECT 
                id,
                filename,
                file_type,
                trust_score,
                status,
                uploaded_at
            FROM evidence
            WHERE case_id = :case_id
            ORDER BY uploaded_at DESC
        """
        result = await db.execute(text(query), {"case_id": case_id})
        rows = result.fetchall()
        return [
            {
                "id": str(row[0]),
                "filename": row[1],
                "file_type": row[2],
                "trust_score": float(row[3]) if row[3] is not None else 0,
                "status": row[4],
                "uploaded_at": row[5].isoformat() if row[5] else None
            }
            for row in rows
        ]
    except Exception as e:
        logger.error(f"Error getting evidence by case: {str(e)}")
        raise HTTPException(status_code=500, detail=str(e))
