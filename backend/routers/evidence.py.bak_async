# backend/routers/evidence.py
from typing import Optional, List, Dict, Any
from fastapi import APIRouter, Depends, HTTPException, Query, UploadFile, File
from sqlalchemy.orm import Session
from sqlalchemy import text
from backend.database import get_db
import logging
import uuid
from datetime import datetime

logger = logging.getLogger(__name__)

router = APIRouter(prefix="/api/v1/evidence", tags=["evidence"])


@router.get("/stats")
async def get_evidence_stats(
    db: Session = Depends(get_db)
):
    """Get evidence statistics"""
    try:
        query = """
            SELECT 
                COUNT(*) as total,
                COUNT(CASE WHEN status = 'verified' THEN 1 END) as verified,
                COUNT(CASE WHEN status = 'pending' THEN 1 END) as pending,
                COUNT(CASE WHEN status = 'rejected' THEN 1 END) as rejected
            FROM evidence
        """
        result = db.execute(text(query))
        row = result.fetchone()
        
        return {
            "total": row[0] or 0,
            "verified": row[1] or 0,
            "pending": row[2] or 0,
            "rejected": row[3] or 0
        }
    except Exception as e:
        logger.error(f"Error getting evidence stats: {str(e)}")
        raise HTTPException(status_code=500, detail=str(e))


@router.get("/top")
async def get_top_evidence(
    limit: int = 10,
    db: Session = Depends(get_db)
):
    """Get top evidence by trust score"""
    try:
        query = """
            SELECT 
                e.id,
                e.case_id,
                e.filename,
                e.file_type,
                e.trust_score,
                e.status,
                e.verified_at,
                e.uploaded_at,
                c.title as case_title
            FROM evidence e
            LEFT JOIN cases c ON e.case_id = c.id::text
            WHERE e.trust_score IS NOT NULL
            ORDER BY e.trust_score DESC
            LIMIT :limit
        """
        result = db.execute(text(query), {"limit": limit})
        rows = result.fetchall()
        
        return [
            {
                "id": str(row[0]),
                "case_id": str(row[1]) if row[1] else None,
                "filename": row[2],
                "file_type": row[3],
                "trust_score": float(row[4]) if row[4] else 0,
                "status": row[5],
                "verified_at": row[6].isoformat() if row[6] else None,
                "uploaded_at": row[7].isoformat() if row[7] else None,
                "case_title": row[8]
            }
            for row in rows
        ]
    except Exception as e:
        logger.error(f"Error getting top evidence: {str(e)}")
        raise HTTPException(status_code=500, detail=str(e))


@router.get("/case/{case_id}")
async def get_evidence_by_case(
    case_id: str,
    db: Session = Depends(get_db)
):
    """Get evidence by case ID"""
    try:
        query = """
            SELECT 
                id,
                filename,
                file_type,
                trust_score,
                status,
                uploaded_at
            FROM evidence
            WHERE case_id = :case_id
            ORDER BY uploaded_at DESC
        """
        result = db.execute(text(query), {"case_id": case_id})
        rows = result.fetchall()
        
        return [
            {
                "id": str(row[0]),
                "filename": row[1],
                "file_type": row[2],
                "trust_score": float(row[3]) if row[3] else 0,
                "status": row[4],
                "uploaded_at": row[5].isoformat() if row[5] else None
            }
            for row in rows
        ]
    except Exception as e:
        logger.error(f"Error getting evidence by case: {str(e)}")
        raise HTTPException(status_code=500, detail=str(e))


@router.post("/upload")
async def upload_evidence(
    case_id: str,
    file: UploadFile = File(...),
    db: Session = Depends(get_db)
):
    """Upload evidence file"""
    try:
        # Generate ID
        evidence_id = str(uuid.uuid4())
        
        # Insert into database
        query = """
            INSERT INTO evidence (
                id,
                case_id,
                filename,
                file_type,
                status,
                uploaded_at
            ) VALUES (
                :id,
                :case_id,
                :filename,
                :file_type,
                'pending',
                NOW()
            )
            RETURNING id
        """
        
        result = db.execute(
            text(query),
            {
                "id": evidence_id,
                "case_id": case_id,
                "filename": file.filename,
                "file_type": file.content_type
            }
        )
        db.commit()
        
        return {
            "id": str(result.scalar()),
            "message": "Evidence uploaded successfully",
            "filename": file.filename
        }
    except Exception as e:
        db.rollback()
        logger.error(f"Error uploading evidence: {str(e)}")
        raise HTTPException(status_code=500, detail=str(e))


@router.get("/{evidence_id}/verify")
async def verify_evidence(
    evidence_id: str,
    db: Session = Depends(get_db)
):
    """Verify evidence"""
    try:
        query = """
            UPDATE evidence
            SET 
                status = 'verified',
                verified_at = NOW(),
                trust_score = COALESCE(trust_score, 85)
            WHERE id = :id
            RETURNING id, trust_score
        """
        result = db.execute(text(query), {"id": evidence_id})
        db.commit()
        
        row = result.fetchone()
        if not row:
            raise HTTPException(status_code=404, detail="Evidence not found")
        
        return {
            "id": str(row[0]),
            "trust_score": float(row[1]) if row[1] else 85,
            "status": "verified"
        }
    except HTTPException:
        raise
    except Exception as e:
        db.rollback()
        logger.error(f"Error verifying evidence: {str(e)}")
        raise HTTPException(status_code=500, detail=str(e))
