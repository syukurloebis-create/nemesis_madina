from backend.cases.event_store import get_case_events, append_event, get_last_event

class EventStoreService:
    @staticmethod
    async def get_events(case_id: str, db):
        return await get_case_events(db, case_id)
    
    @staticmethod
    async def append_event(case_id: str, event_type: str, data: dict, db, user_id: str = None):
        return await append_event(db, case_id, event_type, data, user_id)
    
    @staticmethod
    async def get_last_event(case_id: str, db):
        return await get_last_event(db, case_id)
