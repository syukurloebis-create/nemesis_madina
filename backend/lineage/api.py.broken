from backend.infrastructure.database import get_db
from backend.security.dependencies import get_current_active_user
from backend.security.models import User
"""Lineage Tracking API Endpoints"""

from typing import Dict, Any, List, Optional
from pydantic import BaseModel
from datetime import datetime

from backend.infrastructure.database import get_db
from backend.security.dependencies import get_current_active_user
from backend.security.models import User
from backend.lineage.tracker import tracker

router = APIRouter(prefix="/lineage", tags=["lineage"])

# ============================================================================
# Request/Response Models
# ============================================================================

class AddNodeRequest(BaseModel):
    node_type: str  # input, transform, decision, output
    data: Dict[str, Any]
    inputs: Optional[List[str]] = None

class LineageNodeResponse(BaseModel):
    id: str
    type: str
    timestamp: str
    data: Dict[str, Any]
    hash: str

class DecisionPathResponse(BaseModel):
    decision_id: str
    path_length: int
    inputs: List[Dict]
    transforms: List[Dict]
    decision: List[Dict]
    outputs: List[Dict]
    verified: bool

# ============================================================================
# Endpoints
# ============================================================================

@router.post("/node")
async def add_lineage_node(
    request: AddNodeRequest,
    current_user: User = Depends(get_current_active_user)
):
    """Add a node to lineage graph"""
    node_id = tracker.add_node(
        node_type=request.node_type,
        data=request.data,
        inputs=request.inputs
    )
    
    return {
        "node_id": node_id,
        "message": "Node added successfully"
    }


@router.get("/summary")
async def lineage_summary(
    db: AsyncSession = Depends(get_db),
    current_user: User = Depends(get_current_active_user)
):
    """Summary of event lineage from event_lineage table"""
    from sqlalchemy import text
    
    result = await db.execute(text("""
        SELECT 
            COUNT(*) as total_events,
            COUNT(DISTINCT aggregate_id) as total_aggregates,
            COUNT(previous_hash) as chained_events
        FROM event_lineage
    """))
    row = result.fetchone()
    
    if not row or row[0] == 0:
        result = await db.execute(text("""
            SELECT 
                COUNT(*) as total_events,
                COUNT(DISTINCT case_id) as total_aggregates,
                COUNT(previous_hash) as chained_events
            FROM events
        """))
        row = result.fetchone()
    
    return {
        "status": "ok",
        "total_events": row[0] if row else 0,
        "total_aggregates": row[1] if row else 0,
        "chained_events": row[2] if row else 0,
        "genesis_events": (row[0] - row[2]) if row else 0,
        "lineage_ready": True
    }


@router.get("/verify/{aggregate_id}")
async def verify_lineage(
    aggregate_id: str,
    db: AsyncSession = Depends(get_db),
    current_user: User = Depends(get_current_active_user)
):
    """Verify cryptographic chain integrity for an aggregate"""
    from sqlalchemy import text
    
    result = await db.execute(
        text("""
            SELECT 
                sequence_num,
                event_hash,
                previous_hash
            FROM event_lineage
            WHERE aggregate_id = :aggregate_id
            ORDER BY sequence_num
        """),
        {"aggregate_id": aggregate_id}
    )
    events = result.fetchall()
    
    if not events:
        result = await db.execute(
            text("""
                SELECT 
                    version as sequence_num,
                    event_hash,
                    previous_hash
                FROM events
                WHERE case_id = :aggregate_id
                ORDER BY version
            """),
            {"aggregate_id": aggregate_id}
        )
        events = result.fetchall()
    
    if not events:
        raise HTTPException(status_code=404, detail=f"Aggregate {aggregate_id} not found")
    
    chain_valid = True
    broken_at = None
    
    for i, event in enumerate(events):
        if i > 0:
            if event[2] != events[i-1][1]:
                chain_valid = False
                broken_at = event[0]
                break
    
    return {
        "aggregate_id": aggregate_id,
        "total_events": len(events),
        "chain_valid": chain_valid,
        "broken_at_sequence": broken_at,
        "verified_at": "now"
    }


@router.get("/node/{node_id}")
async def get_lineage_node(
    node_id: str,
    current_user: User = Depends(get_current_active_user)
):
    """Get lineage node by ID"""
    node = tracker.get_node(node_id)
    if not node:
        raise HTTPException(status_code=404, detail=f"Node {node_id} not found")
    return node


@router.get("/decision/{decision_id}/path")
async def get_decision_path(
    decision_id: str,
    current_user: User = Depends(get_current_active_user)
):
    """Get full decision path for a decision"""
    path = tracker.get_decision_path(decision_id)
    if not path:
        raise HTTPException(status_code=404, detail=f"Decision {decision_id} not found")
    return path
