from fastapi import FastAPI, Depends, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import JSONResponse
from contextlib import asynccontextmanager
import logging

# Database
from backend.infrastructure.database import engine, Base

# Routers - Import semua router yang dibutuhkan
from backend.routers import cases as cases_router
from backend.routers import auth as auth_router
from backend.routers import rebuild as rebuild_router
from backend.routers import replay as replay_router
from backend.routers import historical as historical_router
from backend.routers import snapshots as snapshot_router
from backend.routers import integrity as integrity_router
from backend.routers import reports as reports_router
from backend.routers import upload_processor as upload_processor_router
from backend.routers import vendors as vendors_router
from backend.routers import governance as governance_router
from backend.routers import metrics as metrics_router
from backend.routers import trust_metrics as trust_metrics_router
from backend.routers import replay_metrics as replay_metrics_router
from backend.routers import risk_metrics as risk_metrics_router
from backend.routers import alert as alert_router
from backend.routers import entities as entities_router
from backend.routers import events as events_router

# Procurement router (tanpa auth untuk testing)
from backend.routers import procurement_api

# Setup logging
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

@asynccontextmanager
async def lifespan(app: FastAPI):
    # Startup
    logger.info("Starting NEMESIS V8+ API...")
    async with engine.begin() as conn:
        await conn.run_sync(Base.metadata.create_all)
    logger.info("Database ready")
    yield
    # Shutdown
    logger.info("Shutting down...")

app = FastAPI(
    title="Nemesis Madina V8",
    description="Platform Audit & Inspeksi untuk Aparat Penegak Hukum",
    version="8.0.0",
    lifespan=lifespan
)

# CORS Middleware
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# Root endpoint
@app.get("/")
async def root():
    return {"message": "NEMESIS V8+ API is running", "status": "healthy"}

@app.get("/health")
async def health():
    return {"status": "healthy"}

# Register routers
app.include_router(cases_router.router)
app.include_router(auth_router.router)
app.include_router(rebuild_router.router)
app.include_router(replay_router.router)
app.include_router(historical_router.router)
app.include_router(snapshot_router.router)
app.include_router(integrity_router.router)
app.include_router(reports_router.router)
app.include_router(upload_processor_router.router)
app.include_router(vendors_router.router)
app.include_router(governance_router.router)
app.include_router(metrics_router.router)
app.include_router(trust_metrics_router.router)
app.include_router(replay_metrics_router.router)
app.include_router(risk_metrics_router.router)
app.include_router(alert_router.router)
app.include_router(entities_router.router)
app.include_router(events_router.router)
app.include_router(procurement_api.router)  # Procurement API tanpa auth

if __name__ == "__main__":
    import uvicorn
    uvicorn.run(app, host="0.0.0.0", port=8000)
