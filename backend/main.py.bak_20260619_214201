# backend/main.py
from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware
import logging

# Import routers
from backend.routers import cases
from backend.routers import recommendations
from backend.routers import evidence
from backend.routers import evidence_scoring
from backend.routers import decisions
from backend.routers import fraud
from backend.routers import export
from backend.routers import investigation
from backend.routers import provenance
from backend.routers import executive
