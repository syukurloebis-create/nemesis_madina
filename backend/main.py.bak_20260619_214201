from backend.routers import entity

# Setup logging
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

# Create app
app = FastAPI(
    title="NEMESIS API",
    description="NEMESIS AI Audit Intelligence Platform",
    version="8.0.0"
)

# CORS
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# Register routers - EACH ONLY ONCE
app.include_router(cases.router)
app.include_router(recommendations.router)
app.include_router(evidence.router)
app.include_router(evidence_scoring.router)
app.include_router(decisions.router)
app.include_router(fraud.router)
app.include_router(export.router)
app.include_router(investigation.router)
app.include_router(provenance.router)
app.include_router(executive.router)
app.include_router(network.router)
app.include_router(governance.router)
app.include_router(copilot.router)
app.include_router(dashboard.router)
app.include_router(strategic.router)
app.include_router(graph.router)
app.include_router(risk.router)
app.include_router(procurement.router)
app.include_router(workflow.router)
app.include_router(outcome.router)
app.include_router(predictive.router)
app.include_router(metrics.router)
app.include_router(replay.router)
app.include_router(historical.router)
app.include_router(custody.router)
app.include_router(rup.router)
# app.include_router(intelligence.router)
app.include_router(entity.router)

# Health check
@app.get("/health")
async def health_check():
    return {"status": "healthy", "version": "8.0", "database": "connected"}

@app.get("/")
async def root():
    return {"message": "NEMESIS AI API", "version": "8.0", "status": "running"}

if __name__ == "__main__":
    import uvicorn
    uvicorn.run(app, host="0.0.0.0", port=8000)
