# Configure logging
logging.basicConfig(
    level=logging.DEBUG if settings.DEBUG else logging.INFO,
    format="%(asctime)s - %(name)s - %(levelname)s - %(message)s"
)
logger = logging.getLogger(__name__)


# Pydantic Models
class EventCreateRequest(BaseModel):
    aggregate_id: str
    aggregate_type: str
    event_type: str
    payload: Dict[str, Any]
    metadata: Dict[str, Any]


class EventResponse(BaseModel):
    success: bool
    event: Optional[Dict[str, Any]] = None
    error: Optional[str] = None


class LoginRequest(BaseModel):
    username: str
    password: str


class TokenResponse(BaseModel):
    access_token: str
    refresh_token: str
    token_type: str = "bearer"


@asynccontextmanager
async def lifespan(app: FastAPI):
    """Application lifespan manager"""
    logger.info(f"Starting {settings.APP_NAME} in {settings.ENVIRONMENT} mode")
    
    try:
        conn = sqlite3.connect('rup_database.db')
        cursor = conn.cursor()
        cursor.execute("""
            CREATE TABLE IF NOT EXISTS rup_paket (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                nomor_id VARCHAR(50) UNIQUE NOT NULL,
                nama_paket TEXT NOT NULL,
                pagu DECIMAL(20,2),
                jenis VARCHAR(50),
                tahun INTEGER,
                kategori VARCHAR(100),
                metode VARCHAR(100),
                bulan VARCHAR(50),
                lokasi VARCHAR(100),
                instansi VARCHAR(200),
                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
            )
        """)
        cursor.execute("CREATE INDEX IF NOT EXISTS idx_rup_nomor_id ON rup_paket(nomor_id)")
        cursor.execute("CREATE INDEX IF NOT EXISTS idx_rup_tahun ON rup_paket(tahun)")
        conn.commit()
        conn.close()
        logger.info("✅ RUP Database initialized successfully")
    except Exception as e:
        logger.error(f"❌ Failed to initialize RUP database: {e}")
    
    db_healthy = await check_db_health()
    if db_healthy:
        logger.info("✅ Database connection successful")
    else:
        logger.error("❌ Database connection failed!")
    
    yield
    logger.info("Shutting down...")


app = FastAPI(
    title=settings.APP_NAME,
    version="8.0",
    lifespan=lifespan
)

# CORS Middleware
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_methods=["*"],
    allow_headers=["*"]
)

# Trusted Host Middleware
app.add_middleware(
    TrustedHostMiddleware, 
    allowed_hosts=["localhost", "127.0.0.1", "*.nemesis.local"]
)


# ============================================================
# INCLUDE ROUTERS
# ============================================================

app.include_router(cases.router)
app.include_router(evidence.router)
app.include_router(custody.router)
app.include_router(procurement.router) 
app.include_router(integrity.router)
app.include_router(auth_router)
app.include_router(rup.router)


# ============================================================
# HEALTH & SYSTEM ENDPOINTS
# ============================================================

@app.get("/health")
async def health_check():
    """Health check endpoint"""
    db_healthy = await check_db_health()
    
    return {
        "status": "healthy" if db_healthy else "degraded",
        "version": "8.0",
        "environment": settings.ENVIRONMENT,
        "timestamp": datetime.utcnow().isoformat(),
        "database": "connected" if db_healthy else "disconnected"
    }


@app.get("/")
async def root():
    return {
        "app": settings.APP_NAME,
        "version": "8.0",
        "status": "operational",
        "message": "NEMESIS V8+ Digital Evidence Preservation Platform"
    }


@app.get("/db-test")
async def test_db_connection(db: AsyncSession = Depends(get_db)):
    """Test database connection directly"""
    try:
        result = await db.execute(text("SELECT 1 as test"))
        val = result.scalar()
        return {"status": "success", "result": val}
    except Exception as e:
        logger.error(f"DB test failed: {e}")
        return {"status": "failed", "error": str(e)}
