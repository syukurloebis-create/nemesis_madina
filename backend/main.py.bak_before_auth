@app.get("/temporal/case/{case_id}/state")
async def get_state_at_time(
    case_id: str,
    timestamp: str,
    db: AsyncSession = Depends(get_db)
):
    """Get case state at specific timestamp"""
    try:
        # Parse timestamp - handle both with and without Z
        if timestamp.endswith('Z'):
            timestamp = timestamp[:-1] + '+00:00'
        
        target_time = datetime.fromisoformat(timestamp)
        
        # Ensure timezone-aware for comparison
        if target_time.tzinfo is None:
            target_time = target_time.replace(tzinfo=datetime.now().astimezone().tzinfo)
        
        result = await db.execute(
            text("""
                SELECT event_type, data, version, created_at
                FROM events 
                WHERE case_id = :case_id 
                  AND created_at <= :timestamp
                ORDER BY version ASC
            """),
            {"case_id": case_id, "timestamp": target_time}
        )
        rows = result.fetchall()
        
        # Rebuild state
        state = {
            "case_id": case_id,
            "target_time": timestamp,
            "events_before": len(rows),
            "reconstructed_state": {}
        }
        
        for row in rows:
            event_type = row[0]
            data = row[1] if row[1] else {}
            if event_type == 'CASE_CREATED':
                state["reconstructed_state"]["title"] = data.get('title')
                state["reconstructed_state"]["description"] = data.get('description')
            elif event_type == 'CASE_UPDATED':
                if 'title' in data:
                    state["reconstructed_state"]["title"] = data['title']
                if 'description' in data:
                    state["reconstructed_state"]["description"] = data['description']
            elif event_type == 'EVIDENCE_UPLOADED':
                if 'evidence' not in state["reconstructed_state"]:
                    state["reconstructed_state"]["evidence"] = []
                state["reconstructed_state"]["evidence"].append(data.get('filename'))
        
        return state
    except Exception as e:
        logger.error(f"Error getting state at time: {e}")
        return {
            "case_id": case_id,
            "target_time": timestamp,
            "events_before": 0,
            "reconstructed_state": {},
            "error": str(e)
        }


