        return {
            "status": "UNAVAILABLE",
            "events_verified": 0,
            "chain_intact": True,
            "message": "Integrity verification module not loaded"
        }
    except Exception as e:
        logger.error(f"Error verifying integrity: {e}")
        return {
            "status": "ERROR",
            "events_verified": 0,
            "chain_intact": False,
            "error": str(e)
        }


@app.get("/integrity/verify-all")
async def verify_all_integrity(db: AsyncSession = Depends(get_db)):
    """Verify integrity of all event chains"""
    try:
        from backend.events.repository import EventRepository
        from backend.events.verifier import IntegrityVerifier
        
        result = await db.execute(text("SELECT DISTINCT case_id FROM events"))
        case_ids = [row[0] for row in result.fetchall()]
        
        repo = EventRepository(db, tenant_id=settings.DEFAULT_TENANT_ID)
        verifier = IntegrityVerifier(repo)
        
        results = {}
        passed_count = 0
        
        for case_id in case_ids:
            case_id_str = str(case_id)
            try:
                verification = await verifier.verify_aggregate_chain(case_id_str)
                results[case_id_str] = verification
                if verification.get('status') == 'PASS':
                    passed_count += 1
            except Exception as e:
                results[case_id_str] = {"status": "ERROR", "error": str(e)}
        
        return {
            "total_cases": len(case_ids),
            "passed_cases": passed_count,
            "failed_cases": len(case_ids) - passed_count,
            "results": results
        }
    except ImportError as e:
        logger.warning(f"Integrity verifier not available: {e}")
        return {
            "total_cases": 0,
            "passed_cases": 0,
            "failed_cases": 0,
            "message": "Integrity verification module not loaded"
        }
    except Exception as e:
        logger.error(f"Error verifying all integrity: {e}")
        return {
            "total_cases": 0,
            "passed_cases": 0,
            "failed_cases": 0,
            "error": str(e)
        }


