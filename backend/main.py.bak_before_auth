import os
import sqlite3
from pathlib import Path

# Tentukan path database RUP
RUP_DB_PATH = Path(__file__).parent.parent / "rup_database.db"
# atau
# RUP_DB_PATH = "rup_database.db"

def get_rup_connection():
    """Mendapatkan koneksi ke database RUP"""
    conn = sqlite3.connect(str(RUP_DB_PATH))
    conn.row_factory = sqlite3.Row
    return conn

def init_rup_database():
    """Inisialisasi database RUP"""
    try:
        conn = get_rup_connection()
        cursor = conn.cursor()
        
        # Create table
        cursor.execute("""
            CREATE TABLE IF NOT EXISTS rup_paket (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                nomor_id VARCHAR(50) UNIQUE NOT NULL,
                nama_paket TEXT NOT NULL,
                pagu DECIMAL(20,2),
                jenis VARCHAR(50),
                tahun INTEGER,
                kategori VARCHAR(100),
                metode VARCHAR(100),
                bulan VARCHAR(50),
                lokasi VARCHAR(100),
                instansi VARCHAR(200),
                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
            )
        """)
        
        # Create indexes
        cursor.execute("CREATE INDEX IF NOT EXISTS idx_rup_nomor_id ON rup_paket(nomor_id)")
        cursor.execute("CREATE INDEX IF NOT EXISTS idx_rup_tahun ON rup_paket(tahun)")
        cursor.execute("CREATE INDEX IF NOT EXISTS idx_rup_jenis ON rup_paket(jenis)")
        
        conn.commit()
        conn.close()
        logger.info("✅ RUP Database initialized successfully at: {}".format(RUP_DB_PATH))
        return True
    except Exception as e:
        logger.error(f"❌ Failed to initialize RUP database: {e}")
        return False


@app.post("/api/upload-rup")
async def upload_rup_file(file: UploadFile = File(...)):
    """Upload file CSV/Excel data RUP"""
    import io
    import pandas as pd
    
    try:
        # Pastikan database sudah siap
        init_rup_database()
        
        # Baca file
        contents = await file.read()
        
        if not contents:
            raise HTTPException(status_code=400, detail="File kosong")
        
        # Parse file berdasarkan ekstensi
        if file.filename.endswith('.csv'):
            # Coba berbagai encoding
            for encoding in ['utf-8', 'latin1', 'cp1252', 'iso-8859-1']:
                try:
                    df = pd.read_csv(io.StringIO(contents.decode(encoding)), sep=';')
                    break
                except UnicodeDecodeError:
                    continue
            else:
                raise HTTPException(status_code=400, detail="Tidak dapat membaca file CSV. Coba encoding lain.")
        elif file.filename.endswith(('.xlsx', '.xls')):
            df = pd.read_excel(io.BytesIO(contents))
        else:
            raise HTTPException(status_code=400, detail="Format file tidak didukung. Gunakan CSV atau Excel.")
        
        # Validasi kolom
        required_columns = ['nama_paket', 'pagu', 'jenis', 'tahun', 'kategori', 
                           'metode', 'bulan', 'lokasi', 'instansi', 'nomor_id']
        
        # Bersihkan nama kolom
        df.columns = df.columns.str.strip()
        
        missing = [col for col in required_columns if col not in df.columns]
        if missing:
            raise HTTPException(status_code=400, detail=f"Kolom hilang: {missing}")
        
        # Simpan ke database
        conn = get_rup_connection()
        new_count = 0
        duplicate_count = 0
        error_count = 0
        
        for _, row in df.iterrows():
            try:
                nomor_id = str(row['nomor_id']).strip()
                if not nomor_id or nomor_id == 'nan':
                    error_count += 1
                    continue
                
                # Cek duplikat
                cursor = conn.execute("SELECT 1 FROM rup_paket WHERE nomor_id = ?", (nomor_id,))
                existing = cursor.fetchone()
                
                # Parse pagu
                try:
                    pagu_str = str(row['pagu']).replace('.', '').replace(',', '.').strip()
                    pagu = float(pagu_str) if pagu_str and pagu_str not in ['nan', ''] else 0
                except:
                    pagu = 0
                
                # Parse tahun
                try:
                    tahun = int(row['tahun']) if pd.notna(row['tahun']) else 2025
                except:
                    tahun = 2025
                
                if not existing:
                    conn.execute("""
                        INSERT INTO rup_paket (
                            nomor_id, nama_paket, pagu, jenis, tahun, 
                            kategori, metode, bulan, lokasi, instansi
                        ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                    """, (
                        nomor_id[:50], 
                        str(row['nama_paket'])[:500], 
                        pagu, 
                        str(row['jenis'])[:50], 
                        tahun,
                        str(row['kategori'])[:100], 
                        str(row['metode'])[:100], 
                        str(row['bulan'])[:50], 
                        str(row['lokasi'])[:100], 
                        str(row['instansi'])[:200]
                    ))
                    new_count += 1
                else:
                    duplicate_count += 1
                    
            except Exception as row_error:
                error_count += 1
                logger.warning(f"Error processing row: {row_error}")
                continue
        
        conn.commit()
        conn.close()
        
        return {
            "success": True,
            "total": len(df),
            "new": new_count,
            "duplicate": duplicate_count,
            "errors": error_count,
            "message": f"Upload selesai! {new_count} data baru, {duplicate_count} duplikat, {error_count} error"
        }
        
    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"Error uploading RUP file: {e}")
        raise HTTPException(status_code=500, detail=str(e))


@app.get("/api/rup-data")
async def get_rup_data(
    page: int = 1, 
    limit: int = 50, 
    search: str = None, 
    tahun: int = None, 
    jenis: str = None
):
    """Get RUP data with pagination and filters"""
    try:
        # Pastikan database dan tabel ada
        init_rup_database()
        
        conn = get_rup_connection()
        offset = (page - 1) * limit
        
        # Build query
        query = "SELECT * FROM rup_paket WHERE 1=1"
        params = []
        
        if search:
            query += " AND (nama_paket LIKE ? OR nomor_id LIKE ? OR instansi LIKE ?)"
            search_term = f"%{search}%"
            params.extend([search_term, search_term, search_term])
        
        if tahun:
            query += " AND tahun = ?"
            params.append(tahun)
        
        if jenis:
            query += " AND jenis = ?"
            params.append(jenis)
        
        # Get total count
        count_query = query.replace("SELECT *", "SELECT COUNT(*)")
        cursor = conn.execute(count_query, params)
        total = cursor.fetchone()[0]
        
        # Get paginated data
        query += " ORDER BY tahun DESC, id DESC LIMIT ? OFFSET ?"
        params.extend([limit, offset])
        
        df = pd.read_sql_query(query, conn, params=params)
        conn.close()
        
        # Convert to dict with proper types
        data = []
        for _, row in df.iterrows():
            data.append({
                "id": int(row['id']) if 'id' in row else None,
                "nomor_id": str(row['nomor_id']),
                "nama_paket": str(row['nama_paket']),
                "pagu": float(row['pagu']) if pd.notna(row['pagu']) else 0,
                "jenis": str(row['jenis']),
                "tahun": int(row['tahun']) if pd.notna(row['tahun']) else 0,
                "kategori": str(row['kategori']),
                "metode": str(row['metode']),
                "bulan": str(row['bulan']),
                "lokasi": str(row['lokasi']),
                "instansi": str(row['instansi']),
            })
        
        return {
            "data": data,
            "total": total,
            "page": page,
            "limit": limit,
            "total_pages": (total + limit - 1) // limit if total > 0 else 1
        }
        
    except Exception as e:
        logger.error(f"Error getting RUP data: {e}")
        # Return empty data instead of error
        return {
            "data": [],
            "total": 0,
            "page": page,
            "limit": limit,
            "total_pages": 1
        }


@app.get("/api/rup-stats")
async def get_rup_stats():
    """Get RUP statistics"""
    try:
        # Pastikan database dan tabel ada
        init_rup_database()
        
        conn = get_rup_connection()
        
        # Check if table has data
        cursor = conn.execute("SELECT COUNT(*) FROM rup_paket")
        total_count = cursor.fetchone()[0]
        
        if total_count == 0:
            conn.close()
            return {
                "total": 0,
                "by_year": [],
                "by_type": [],
                "total_pagu": 0
            }
        
        # Get total
        cursor = conn.execute("SELECT COUNT(*) as count FROM rup_paket")
        total = cursor.fetchone()[0]
        
        # Get by year
        cursor = conn.execute("""
            SELECT tahun, COUNT(*) as count, COALESCE(SUM(pagu), 0) as total_pagu 
            FROM rup_paket 
            GROUP BY tahun 
            ORDER BY tahun
        """)
        by_year = [{"tahun": row[0], "count": row[1], "total_pagu": row[2]} for row in cursor.fetchall()]
        
        # Get by type
        cursor = conn.execute("""
            SELECT jenis, COUNT(*) as count 
            FROM rup_paket 
            GROUP BY jenis
        """)
        by_type = [{"jenis": row[0], "count": row[1]} for row in cursor.fetchall()]
        
        # Get total pagu
        cursor = conn.execute("SELECT COALESCE(SUM(pagu), 0) as total FROM rup_paket")
        total_pagu = cursor.fetchone()[0]
        
        conn.close()
        
        return {
            "total": total,
            "by_year": by_year,
            "by_type": by_type,
            "total_pagu": float(total_pagu) if total_pagu else 0
        }
        
    except Exception as e:
        logger.error(f"Error getting RUP stats: {e}")
        return {
            "total": 0,
            "by_year": [],
            "by_type": [],
            "total_pagu": 0
        }


@app.delete("/api/rup-data/{nomor_id}")
async def delete_rup_data(nomor_id: str):
    """Delete RUP data by nomor_id"""
    try:
        init_rup_database()
        conn = get_rup_connection()
        cursor = conn.execute("DELETE FROM rup_paket WHERE nomor_id = ?", (nomor_id,))
        affected = cursor.rowcount
        conn.commit()
        conn.close()
        
        if affected > 0:
            return {"success": True, "message": f"Data dengan ID {nomor_id} berhasil dihapus"}
        else:
            raise HTTPException(status_code=404, detail=f"Data dengan ID {nomor_id} tidak ditemukan")
    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"Error deleting RUP data: {e}")

