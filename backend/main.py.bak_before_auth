@app.post("/export/case/{case_id}")
async def export_case(
    case_id: str,
    db: AsyncSession = Depends(get_db)
):
    """Export case as evidence package"""
    try:
        # Create in-memory zip file
        zip_buffer = io.BytesIO()
        
        with zipfile.ZipFile(zip_buffer, 'w', zipfile.ZIP_DEFLATED) as zip_file:
            # Get case data
            result = await db.execute(
                text("SELECT id, title, description, status, created_at FROM cases WHERE id = :case_id"),
                {"case_id": case_id}
            )
            case = result.fetchone()
            
            if not case:
                raise HTTPException(status_code=404, detail="Case not found")
            
            # Add case metadata
            case_data = {
                "id": str(case[0]),
                "title": case[1],
                "description": case[2],
                "status": case[3],
                "created_at": case[4].isoformat() if case[4] else None,
                "exported_at": datetime.utcnow().isoformat()
            }
            zip_file.writestr("case.json", json.dumps(case_data, indent=2))
            
            # Get events
            result = await db.execute(
                text("""
                    SELECT event_id, event_type, data, timestamp, version, user_id, event_hash
                    FROM events 
                    WHERE case_id = :case_id 
                    ORDER BY version ASC
                """),
                {"case_id": case_id}
            )
            events = result.fetchall()
            
            events_data = []
            for event in events:
                events_data.append({
                    "event_id": str(event[0]),
                    "event_type": event[1],
                    "data": event[2],
                    "timestamp": event[3].isoformat() if event[3] else None,
                    "version": event[4],
                    "user_id": event[5],
                    "event_hash": event[6]
                })
            
            zip_file.writestr("events.jsonl", "\n".join([json.dumps(e) for e in events_data]))
            
            # Get evidence
            result = await db.execute(
                text("SELECT id, filename, sha256_hash, file_size, uploaded_at FROM evidence_files WHERE case_id = :case_id"),
                {"case_id": case_id}
            )
            evidence_files = result.fetchall()
            
            for ev in evidence_files:
                evidence_data = {
                    "id": str(ev[0]),
                    "filename": ev[1],
                    "sha256_hash": ev[2],
                    "file_size": ev[3],
                    "uploaded_at": ev[4].isoformat() if ev[4] else None
                }
                zip_file.writestr(f"evidence/{ev[0]}.json", json.dumps(evidence_data, indent=2))
            
            # Create manifest
            manifest = {
                "case_id": case_id,
                "exported_at": datetime.utcnow().isoformat(),
                "version": "1.0",
                "event_count": len(events_data),
                "evidence_count": len(evidence_files),
                "exported_by": "NEMESIS V8+"
            }
            zip_file.writestr("manifest.json", json.dumps(manifest, indent=2))
        
        zip_buffer.seek(0)
        
        return Response(
            content=zip_buffer.getvalue(),
            media_type="application/zip",
            headers={
                "Content-Disposition": f"attachment; filename=case_{case_id}_export.zip"
            }
        )
    
    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"Error exporting case: {e}")
        raise HTTPException(status_code=500, detail=str(e))


@app.get("/temporal/case/{case_id}/compare")
async def compare_versions(
    case_id: str,
    version_a: int,
    version_b: int,
    db: AsyncSession = Depends(get_db)
):
    """Compare two versions of a case"""
    try:
        # Get state at version A
        result_a = await db.execute(
            text("""
                SELECT event_type, data, version, created_at
                FROM events 
                WHERE case_id = :case_id AND version <= :version_a
                ORDER BY version ASC
            """),
            {"case_id": case_id, "version_a": version_a}
        )
        rows_a = result_a.fetchall()
        
        # Build state A
        state_a = {}
        for row in rows_a:
            event_type = row[0]
            data = row[1] if row[1] else {}
            if event_type == 'CASE_CREATED':
                state_a["title"] = data.get('title')
                state_a["description"] = data.get('description')
            elif event_type == 'CASE_UPDATED':
                if 'title' in data:
                    state_a["title"] = data['title']
                if 'description' in data:
                    state_a["description"] = data['description']
        
        # Get state at version B
        result_b = await db.execute(
            text("""
                SELECT event_type, data, version, created_at
                FROM events 
                WHERE case_id = :case_id AND version <= :version_b
                ORDER BY version ASC
            """),
            {"case_id": case_id, "version_b": version_b}
        )
        rows_b = result_b.fetchall()
        
        # Build state B
        state_b = {}
        for row in rows_b:
            event_type = row[0]
            data = row[1] if row[1] else {}
            if event_type == 'CASE_CREATED':
                state_b["title"] = data.get('title')
                state_b["description"] = data.get('description')
            elif event_type == 'CASE_UPDATED':
                if 'title' in data:
                    state_b["title"] = data['title']
                if 'description' in data:
                    state_b["description"] = data['description']
        
        # Calculate differences
        differences = []
        all_keys = set(state_a.keys()) | set(state_b.keys())
        
        for key in all_keys:
            val_a = state_a.get(key)
            val_b = state_b.get(key)
            if val_a != val_b:
                differences.append({
                    "field": key,
                    "from": val_a,
                    "to": val_b
                })
        
        return {
            "case_id": case_id,
            "version_a": version_a,
            "version_b": version_b,
            "state_a": state_a,
            "state_b": state_b,
            "differences": differences,
            "has_changes": len(differences) > 0
        }
    except Exception as e:
        logger.error(f"Error comparing versions: {e}")
