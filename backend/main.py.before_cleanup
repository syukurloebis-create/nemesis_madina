@app.get("/api/procurement/stats")
async def procurement_stats():
    try:
        async with AsyncSessionLocal() as db:
            result = await db.execute(
                text("""
                    SELECT
                        COUNT(*) as total,
                        COALESCE(SUM(amount),0) as amount
                    FROM procurement_records
                """)
            )

            row = result.fetchone()

            return {
                "success": True,
                "total_records": row[0],
                "total_amount": float(row[1]),
            }

    except Exception as e:
        logger.exception(e)

        return {
            "success": False,
            "error": str(e),
        }


@app.get("/api/procurement/list")
async def procurement_list(limit: int = 100):
    try:
        async with AsyncSessionLocal() as db:

            result = await db.execute(
                text("""
                    SELECT
                        id,
                        procurement_id,
                        title,
                        vendor,
                        amount,
                        date
                    FROM procurement_records
                    ORDER BY date DESC
                    LIMIT :limit
                """),
                {"limit": limit},
            )

            rows = result.fetchall()

            return {
                "success": True,
                "count": len(rows),
                "records": [
                    {
                        "id": r[0],
                        "procurement_id": r[1],
                        "title": r[2],
                        "vendor": r[3],
                        "amount": float(r[4]),
                        "date": str(r[5]),
                    }
                    for r in rows
                ],
            }

    except Exception as e:
        logger.exception(e)

        return {
            "success": False,
            "count": 0,
            "records": [],
            "error": str(e),
        }


