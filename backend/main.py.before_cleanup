from sqlalchemy import select
from backend.security.models import User
from backend.infrastructure.database import AsyncSessionLocal
from backend.security.auth import create_password_hash  # kita buat helper

async def ensure_admin():
    async with AsyncSessionLocal() as db:
        result = await db.execute(
            select(User).where(User.username == "admin")
        )
        admin = result.scalar_one_or_none()

        if admin:
            print("✅ Admin already exists - skip bootstrap")
            return

        new_admin = User(
            id="admin-system",
            username="admin",
            email="admin@nemesis.local",
            full_name="System Administrator",
            password_hash=create_password_hash("Admin123!"),
            role="ADMIN",
            is_active=True,
            is_verified=True,
        )

        db.add(new_admin)
        await db.commit()

        print("🚀 Admin user created automatically")

@app.on_event("startup")
async def startup_event():
    async with AsyncSessionLocal() as db:
        await ensure_admin(db)