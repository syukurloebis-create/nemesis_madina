# ============================================================
# HEALTH ENDPOINTS
# ============================================================

@app.get("/health")
async def health():
    return {
        "status": "healthy",
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "version": "2.0.0",
        "service": "NEMESIS Audit Intelligence Platform",
        "registered_modules": [
            "api_v1", "websocket", "graph", "ml", "auth",
            "evidence", "lineage", "explainability", "audit", 
            "webhooks", "findings", "cases"
        ]
    }


@app.get("/health/live")
async def liveness():
    return {"status": "alive", "timestamp": datetime.now(timezone.utc).isoformat()}


@app.get("/health/ready")
async def readiness():
    return {"status": "ready", "timestamp": datetime.now(timezone.utc).isoformat()}


@app.get("/")
async def root():
    return {
        "name": "NEMESIS Audit Intelligence Platform",
        "version": "2.0.0",
        "status": "operational",
        "endpoints": {
            "health": "/health",
            "docs": "/docs",
            "api": "/api/v1",
            "websocket": "ws://localhost:8000/ws",
            "cases": "/cases"
        }
    }


# ============================================================
# DEBUG ENDPOINTS (SINGLE WORKER VERIFICATION)
# ============================================================

@app.get("/debug/app-id")
async def debug_app_id():
    """Debug endpoint to verify app instance identity"""
    return {
        "app_id": id(app),
        "process_id": os.getpid(),
        "worker_count": 1,
        "reload_enabled": False
    }


@app.get("/debug/routers")
async def debug_routers():
    """Debug endpoint to list all registered routers"""
    routes = []
    for route in app.routes:
        if hasattr(route, 'path'):
            routes.append({
                "path": route.path,
                "methods": list(route.methods) if hasattr(route, 'methods') else []
            })
    
    case_routes = [r for r in routes if "/cases" in r["path"]]
    
    return {
        "total_routes": len(routes),
        "case_routes": case_routes,
        "has_cases_router": len(case_routes) > 0,
        "all_route_paths": [r["path"] for r in routes if r["path"]][:50]
    }


