"""API V1 - Router Container"""

from fastapi import APIRouter

router = APIRouter(tags=["v1"])

# Import routers
from backend.api.v1.events import router as events_router
from backend.api.v1.graph import router as graph_router
from backend.api.v1.intelligence import router as intelligence_router
from backend.api.v1.health import router as health_router
from backend.api.v1.evidence import router as evidence_router

router.include_router(events_router, prefix="/events")
router.include_router(graph_router, prefix="/graph")
router.include_router(intelligence_router, prefix="/intelligence")
router.include_router(health_router, prefix="/health")
router.include_router(evidence_router, prefix="/evidence")


@router.get("/")
async def v1_root():
    return {
        "version": "2.0.0",
        "name": "NEMESIS API",
        "status": "operational"
    }