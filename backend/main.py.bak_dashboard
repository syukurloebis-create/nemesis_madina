# backend/main.py - Minimal version with correct middleware
from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware
from backend.security.auth import router as auth_router
from backend.routers import evidence_scoring
from backend.routers import provenance
from backend.routers import executive
from backend.routers import network
from backend.routers import governance
from backend.routers import copilot

app = FastAPI(title="NEMESIS V8+ API", version="8.0")

# CORS middleware - correct syntax
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# Include routers
app.include_router(auth_router)
app.include_router(evidence_scoring.router)
app.include_router(provenance.router)
app.include_router(executive.router)
app.include_router(network.router)
app.include_router(governance.router)
app.include_router(copilot.router)

@app.get("/health")
async def health():
    return {"status": "healthy", "version": "8.0", "database": "connected"}

@app.get("/")
async def root():
    return {"message": "NEMESIS V8+ API", "version": "8.0"}

if __name__ == "__main__":
    import uvicorn
    uvicorn.run(app, host="0.0.0.0", port=8000)
